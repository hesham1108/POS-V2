@model CashOutIndexViewModel
@using StoresPOS.PL.Extensions
@{
    var listChips = ListUrl.Chips(Context.Request, ("from", L["From"].Value, null), ("to", L["To"].Value, null), ("shiftId", L["Shift"].Value, null), ("userId", L["User"].Value, v => Model.Users.FirstOrDefault(u => u.Id.ToString() == v).Name));
    ViewData["Section"] = L["Cash-outs"].Value;
    ViewData["Title"] = L["Cash-outs"].Value;
    ViewData["Subtitle"] = Model.CanSeeAll
        ? L["Cash taken from the drawer · each one lowers the shift's expected cash"].Value
        : L["Cash-outs of the shift you are working in"].Value;
}

@section PageActions {
    @if (Model.CanCreate && Model.InShift)
    {
        <button type="button" class="btn sp-btn-primary" data-cashout>@L["New cash-out"]</button>
    }
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<partial name="_ListToolbar" model='new ListToolbarModel { Q = null, SearchPlaceholder = "", Chips = listChips, Page = Model.Page, ShowSearch = false }' />


@if (Model.CanSeeAll)
{
    <div class="sp-card p-3 mb-4">
        <form method="get" class="sp-filter-row">
            <div class="sp-filter-row__field">
                <label class="form-label" for="from">@L["From"]</label>
                <input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="sp-filter-row__field">
                <label class="form-label" for="to">@L["To"]</label>
                <input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="sp-filter-row__field">
                <label class="form-label" for="shiftId">@L["Shift"]</label>
                <input class="form-control num" type="number" min="1" id="shiftId" name="shiftId" value="@Model.ShiftId" placeholder="#" />
            </div>
            <div class="sp-filter-row__field">
                <label class="form-label" for="userId">@L["User"]</label>
                <select class="form-select" id="userId" name="userId">
                    <option value="">@L["All"]</option>
                    @foreach (var u in Model.Users)
                    {
                        <option value="@u.Id" selected="@(Model.UserId == u.Id)">@u.Name</option>
                    }
                </select>
            </div>
            <div class="sp-filter-row__actions">
                <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
                <a class="btn sp-btn-secondary" asp-action="Index">@L["Reset"]</a>
            </div>
        </form>
    </div>
}

@if (Model.Items.Count == 0)
{
    var empty = Model.CanSeeAll || Model.InShift
        ? (L["No cash-outs found"].Value, L["Cash taken out of the drawer appears here."].Value)
        : (L["You are not in a shift"].Value, L["Open or join the shift to see and record cash-outs."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-card">
        <div class="table-responsive sp-table-scroll">
            <table class="table sp-table">
                <thead>
                    <tr>
                        <partial name="_SortTh" model='new SortHeader("CreatedAtUtc", L["Date"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("ShiftId", L["Shift"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("UserDisplayName", L["User"].Value, Model.Page)' />
                        <th>@L["Reason"]</th>
                        <partial name="_SortTh" model='new SortHeader("Amount", L["Amount"].Value, Model.Page, Numeric: true)' />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="num">@c.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="num">#@c.ShiftId</td>
                            <td>@c.UserDisplayName</td>
                            <td>@c.Reason</td>
                            <td class="text-end num">@c.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4">@string.Format(L["{0} cash-outs"].Value, Model.Page.TotalCount.ToString("N0"))</th>
                        <th class="text-end num num-total">@Model.Total.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
        <partial name="_Pager" model="Model.Page" />
    </div>
}

@if (Model.CanCreate && Model.InShift)
{
    <partial name="_CashOutModal" />
}

@section Scripts {
    <script src="~/js/cashout.js" asp-append-version="true"></script>
}
