@{
    ViewData["Title"] = "Access Denied";
}

<div class="sp-card p-4" style="max-width: 520px; margin: 2rem auto;">
    <div class="sp-badge mb-3">
        <span class="sp-badge-dot"></span>
        Authorization
    </div>
    <h1 class="h3 mb-2" style="color: var(--sp-text-strong);">Access Denied</h1>
    <p class="mb-4" style="color: var(--sp-text-muted);">
        You do not have permission to access this resource.
    </p>
    <a class="btn sp-btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>
