@model StoresPOS.PL.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Options.IOptionsMonitor<StoresPOS.BLL.Models.StoreSettings> StoreOptions
@{
    ViewData["Title"] = L["Sign in"].Value;
    Layout = "_LoginLayout";
    var loginLogo = StoreOptions.CurrentValue.EffectiveUiLogoPath;
    var isAr = Ui.IsArabic;
    var storeName = StoreOptions.CurrentValue.NameFor(isAr ? "ar" : "en");
    var here = Context.Request.Path + Context.Request.QueryString;
}

<div class="login-page" id="loginPage" dir="@(isAr ? "rtl" : "ltr")" lang="@(isAr ? "ar" : "en")">
    <div class="login-shell">
        <div class="login-brand">
            <div class="login-brand-mark">
                @if (!string.IsNullOrWhiteSpace(loginLogo))
                {
                    <img class="login-brand-mark__logo login-brand-mark__logo--img" src="~/@loginLogo" alt="" />
                }
                else
                {
                    <div class="login-brand-mark__logo" aria-hidden="true">SP</div>
                }
                <div class="login-brand-mark__text">
                    <strong>@storeName</strong>
                    <span >@L["Local store cashier"]</span>
                </div>
            </div>
            <form asp-controller="Culture" asp-action="Set" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ui" value="@(isAr ? "en" : "ar")" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="login-lang" id="loginLangToggle" lang="@(isAr ? "en" : "ar")"
                        aria-label="@(isAr ? L["Switch to English"] : L["Switch to Arabic"])">@(isAr ? "English" : "العربية")</button>
            </form>
        </div>

        <div class="login-card">
            <div class="login-card__eyebrow">
                <span class="sp-badge-dot" aria-hidden="true"></span>
                <span >@L["Secure sign-in"]</span>
            </div>
            <h1 class="login-card__title" >@L["Welcome back"]</h1>
            <p class="login-card__subtitle" >@L["Sign in to open the till and continue store operations."]</p>

            @if (TempData["Success"] is string loginNotice)
            {
                <div class="alert alert-success" role="status">@loginNotice</div>
            }

            <form asp-action="Login" method="post" class="login-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label for="Username" class="form-label" >@L["Username"]</label>
                    <input asp-for="Username"
                           class="form-control"
                           autocomplete="username"
                           autofocus
                           placeholder="@L["Enter username"]" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Password" class="form-label" >@L["Password"]</label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="@L["Enter password"]" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="login-actions">
                    <button type="submit" class="login-submit" >@L["Sign in"]</button>
                </div>
            </form>
        </div>

        <div class="login-footer" >@L["StoresPOS · Local installation"]</div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
