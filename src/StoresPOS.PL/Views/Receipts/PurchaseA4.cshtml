@model PurchaseA4ViewModel
@{
    Layout = "_A4PrintLayout";
    var f = Model.Format;
    f.ApplyCulture();
    var p = Model.Purchase;
    var lang = f.Language;
    var isAr = lang == "ar";
    ViewData["ReceiptFormat"] = f;
    ViewData["AutoPrint"] = Model.AutoPrint;
    ViewData["Title"] = p.InvoiceNumber + " A4";
    var words = AmountInWords.Format(p.SubTotal, lang);
}
<article class="a4-invoice">
    <header class="a4-invoice__header">
        <div class="a4-invoice__store">
            <h1>@f.Settings.NameFor(lang)</h1>
            @if (!string.IsNullOrWhiteSpace(f.Settings.AddressFor(lang)))
            {
                <p>@f.Settings.AddressFor(lang)</p>
            }
            @if (!string.IsNullOrWhiteSpace(f.Settings.TaxNumber))
            {
                <p>@L["Tax no."]: <bdi dir="ltr">@f.Digits(f.Settings.TaxNumber)</bdi></p>
            }
        </div>
        <div class="a4-invoice__meta">
            <strong>@L["Purchase invoice"]</strong>
            <div dir="ltr">@p.InvoiceNumber</div>
            <div>@L["Date"]: <span dir="ltr">@p.InvoiceDate.ToString("yyyy-MM-dd")</span></div>
            <div>@L["Status"]: @p.Status</div>
        </div>
    </header>

    <section class="a4-invoice__party">
        <div>
            <strong>@L["Supplier"]</strong>
            <div>@(isAr ? p.SupplierNameAr : p.SupplierNameEn)</div>
        </div>
        <div>
            <strong>@L["Created by"]</strong>
            <div>@p.CreatedByUsername</div>
            @if (!string.IsNullOrEmpty(p.ConfirmedByUsername))
            {
                <div>@L["Confirmed by"]: @p.ConfirmedByUsername</div>
            }
        </div>
    </section>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>@L["Item"]</th>
                <th>@L["Unit"]</th>
                <th class="n">@L["Qty"]</th>
                <th class="n">@L["Cost"]</th>
                <th class="n">@L["Total"]</th>
            </tr>
        </thead>
        <tbody>
            @{ var n = 1; }
            @foreach (var line in p.Items)
            {
                <tr>
                    <td class="n">@n</td>
                    <td>@(isAr ? line.ProductNameAr : line.ProductNameEn)</td>
                    <td>@line.Unit</td>
                    <td class="n">@f.Qty(line.Quantity)</td>
                    <td class="n">@f.Money(line.UnitCost)</td>
                    <td class="n">@f.Money(line.LineTotal)</td>
                </tr>
                n++;
            }
        </tbody>
    </table>

    <div class="a4-invoice__totals">
        <dl>
            <div class="grand"><dt>@L["Total"]</dt><dd class="n">@f.Money(p.SubTotal) @L["EGP"]</dd></div>
        </dl>
    </div>
    <p class="a4-invoice__words"><strong>@L["Amount in words"]:</strong> @words</p>
    @if (!string.IsNullOrWhiteSpace(p.Notes))
    {
        <p>@p.Notes</p>
    }
    <div class="a4-invoice__sign">
        <div>@L["Prepared by"]</div>
        <div>@L["Received by"]</div>
        <div>@L["Stamp"]</div>
    </div>
</article>
