@model ReturnReceiptViewModel
@inject IPaymentMethodService PaymentMethods
@{
    Layout = "_A4PrintLayout";
    var f = Model.Format;
    f.ApplyCulture();
    var r = Model.Return;
    var lang = f.Language;
    var isAr = lang == "ar";
    ViewData["ReceiptFormat"] = f;
    ViewData["AutoPrint"] = Model.AutoPrint;
    ViewData["Title"] = r.ReturnNumber + " A4";
    var method = await PaymentMethods.GetAsync((byte)r.RefundMethod);
    var methodName = method?.NameFor(lang) ?? r.RefundMethod.ToString();
    var words = AmountInWords.Format(r.TotalAmount, lang);
}
<article class="a4-invoice">
    <header class="a4-invoice__header">
        <div class="a4-invoice__store">
            <h1>@f.Settings.NameFor(lang)</h1>
            <p>@L["Return slip"]</p>
        </div>
        <div class="a4-invoice__meta">
            <strong dir="ltr">@r.ReturnNumber</strong>
            <div>@L["Original invoice"]: <span dir="ltr">@r.OriginalInvoiceNumber</span></div>
            <div>@L["Date"]: <span dir="ltr">@f.DateTime(r.CreatedAtUtc)</span></div>
            <div>@L["Refund method"]: @methodName</div>
        </div>
    </header>

    <table>
        <thead>
            <tr>
                <th>@L["Item"]</th>
                <th class="n">@L["Qty"]</th>
                <th class="n">@L["Price"]</th>
                <th class="n">@L["Total"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in r.Lines)
            {
                <tr>
                    <td>@(isAr ? line.NameAr : line.NameEn)</td>
                    <td class="n">@f.Qty(line.Quantity)</td>
                    <td class="n">@f.Money(line.UnitPrice)</td>
                    <td class="n">@f.Money(line.RefundAmount)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="a4-invoice__totals">
        <dl>
            <div class="grand"><dt>@L["Total"]</dt><dd class="n">@f.Money(r.TotalAmount) @L["EGP"]</dd></div>
        </dl>
    </div>
    <p class="a4-invoice__words"><strong>@L["Amount in words"]:</strong> @words</p>
    @if (!string.IsNullOrWhiteSpace(r.Reason))
    {
        <p>@L["Reason"]: @r.Reason</p>
    }
    <div class="a4-invoice__sign">
        <div>@L["Prepared by"]</div>
        <div>@L["Received by"]</div>
        <div>@L["Stamp"]</div>
    </div>
</article>
