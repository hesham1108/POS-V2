@inject Microsoft.Extensions.Options.IOptionsMonitor<StoresPOS.BLL.Models.StoreSettings> StoreOptions
@using StoresPOS.PL.Extensions
@model ReturnIndexViewModel
@{
    var listChips = ListUrl.SearchChip(Context.Request, L["Search"].Value).Concat(ListUrl.Chips(Context.Request, ("from", L["From"].Value, null), ("to", L["To"].Value, null), ("method", L["Refund method"].Value, null))).ToList();
    ViewData["Section"] = L["Returns"].Value;
    ViewData["Title"] = L["Returns"].Value;
    ViewData["Subtitle"] = Model.CanSeeAll
        ? L["Customer returns · refunded at the prices on the original invoice"].Value
        : L["Returns made in the shift you are working in"].Value;
    // Auto-print after saving follows Settings → Printing → Return slip (paper size + "print automatically").
    var returnPrint = StoreOptions.CurrentValue;
    var autoPrintReturn = returnPrint.PrintSettingsFor(StoresPOS.BLL.Models.PrintDocumentType.Return).AutoPrint;
    var printUrl = Model.PrintId.HasValue
        ? Url.Action(returnPrint.FormatFor(StoresPOS.BLL.Models.PrintDocumentType.Return) == "A4" ? "ReturnA4" : "Return", "Receipts", new { id = Model.PrintId })
        : null;
}

@section PageActions {
    @if (Model.CanCreate)
    {
        <a class="btn sp-btn-primary" asp-action="Create">@L["New return"]</a>
    }
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<partial name="_ListToolbar" model='new ListToolbarModel { Q = Model.Search, SearchPlaceholder = "R-000001 / S-000001", Chips = listChips, Page = Model.Page, ShowSearch = true }' />


@if (printUrl is not null)
{
    @* Return slip prints once after saving. *@
    <div class="alert alert-light d-flex align-items-center gap-3" data-print-on-load="@(autoPrintReturn ? printUrl : null)">
        <span>@(autoPrintReturn ? L["The return slip was sent to the printer."] : L["Return saved."])</span>
        <button type="button" class="btn btn-sm sp-btn-secondary" data-print-url="@printUrl">@(autoPrintReturn ? L["Print again"] : L["Print"])</button>
    </div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <input type="hidden" name="q" value="@Model.Search" />
        }
        <div class="sp-filter-row__field">
            <label class="form-label" for="from">@L["From"]</label>
            <input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="to">@L["To"]</label>
            <input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="method">@L["Refund method"]</label>
            <select class="form-select" id="method" name="method">
                <option value="">@L["All"]</option>
                @foreach (var m in Enum.GetValues<PaymentMethod>())
                {
                    var label = m switch
                    {
                        PaymentMethod.Cash => L["Cash"].Value,
                        PaymentMethod.Card => L["Visa / Card"].Value,
                        PaymentMethod.InstaPay => L["InstaPay"].Value,
                        _ => L["Vodafone Cash"].Value
                    };
                    <option value="@((int)m)" selected="@(Model.Method == m)">@label</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Index">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    var empty = (L["No returns found"].Value, L["Returns are made from the original invoice: scan its receipt barcode."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-card">
        <div class="table-responsive sp-table-scroll">
            <table class="table sp-table">
                <thead>
                    <tr>
                        <partial name="_SortTh" model='new SortHeader("ReturnNumber", L["Return"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("OriginalInvoiceNumber", L["Original invoice"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("CreatedAtUtc", L["Date"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("ShiftId", L["Shift"].Value, Model.Page)' />
                        <partial name="_SortTh" model='new SortHeader("UserDisplayName", L["User"].Value, Model.Page)' />
                        <th>@L["Refund method"]</th>
                        <th>@L["Reason"]</th>
                        <partial name="_SortTh" model='new SortHeader("TotalAmount", L["Amount"].Value, Model.Page, Numeric: true)' />
                        <th><span class="visually-hidden">@L["Print"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="num">@r.ReturnNumber</td>
                            <td>
                                @if (Model.CanSeeAll)
                                {
                                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@r.OriginalInvoiceId" class="num">@r.OriginalInvoiceNumber</a>
                                }
                                else
                                {
                                    <span class="num">@r.OriginalInvoiceNumber</span>
                                }
                            </td>
                            <td class="num">@r.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="num">@(r.ShiftId.HasValue ? "#" + r.ShiftId : "—")</td>
                            <td>@r.UserDisplayName</td>
                            <td><partial name="_RefundMethodLabel" model="r.RefundMethod" /></td>
                            <td>@r.Reason</td>
                            <td class="text-end num">@r.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm sp-btn-secondary" data-print-url="@Url.Action("Return", "Receipts", new { id = r.Id })">80</button>
                                <button type="button" class="btn btn-sm sp-btn-secondary" data-print-url="@Url.Action("ReturnA4", "Receipts", new { id = r.Id })">A4</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="7">@string.Format(L["{0} returns"].Value, Model.Page.TotalCount.ToString("N0"))</th>
                        <th class="text-end num num-total">@Model.Total.ToString("N2")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
        <partial name="_Pager" model="Model.Page" />
    </div>
}
