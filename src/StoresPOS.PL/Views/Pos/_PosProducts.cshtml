@model IReadOnlyList<PosProductDto>
@{
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var currency = L["EGP"].Value;
}
@if (Model.Count == 0)
{
    var empty = (L["No products match"].Value, L["Check the spelling or scan the barcode instead."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="pos-grid" data-count="@Model.Count">
        @foreach (var p in Model)
        {
            var stockClass = p.IsOutOfStock ? "is-out" : p.IsLowStock ? "is-low" : null;
            <button type="button" class="pos-product @(p.IsOutOfStock ? "is-out" : null)" data-product-id="@p.Id"
                    @(p.IsOutOfStock ? "disabled" : null)>
                @* "× N" when this product is already on the invoice — filled by pos.js after each cart refresh. *@
                <span class="pos-product__incart num" dir="ltr" data-incart hidden></span>
                <span class="pos-product__name">@(isAr ? p.NameAr : p.NameEn)</span>
                @if (!string.IsNullOrWhiteSpace(p.Barcode))
                {
                    <span class="pos-product__code">@L["Barcode"]: <span class="num">@p.Barcode</span></span>
                }
                <span class="pos-product__foot">
                    <span class="pos-product__price"><span class="num">@p.Price.ToString("N2")</span> <small>@currency</small></span>
                    <span class="pos-stock @stockClass" title="@(p.IsLowStock ? L["Low stock"].Value : null)">
                        @if (p.IsOutOfStock)
                        {
                            <text>@L["Out of stock"]</text>
                        }
                        else
                        {
                            <text>@L["Remaining"] <span class="num">@p.StockQuantity.ToString("0.###")</span></text>
                        }
                    </span>
                </span>
            </button>
        }
    </div>
}
