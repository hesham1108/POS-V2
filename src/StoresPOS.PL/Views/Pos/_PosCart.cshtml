@model PosCartViewModel
@{
    var cart = Model.Cart;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var wholesale = cart.SaleType == SaleType.Wholesale;
    var currency = L["EGP"].Value;
    var hasCustomer = cart.CustomerId.HasValue;
    // Customer bar: walk-in (retail, no customer) | wholesale (no customer) | registered customer.
    var mode = hasCustomer ? "registered" : wholesale ? "wholesale" : "walkin";
}
<div class="pos-cart" data-total="@cart.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-empty="@(cart.IsEmpty ? "true" : "false")" data-held="@cart.HeldCount"
     data-customer-id="@cart.CustomerId" data-sale-type="@((int)cart.SaleType)"
     data-subtotal="@cart.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-discount="@cart.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">

    <div class="pos-cart__head">
        <h2 class="pos-cart__title">@L["New invoice"]</h2>
        <span class="pos-cart__count">@string.Format(L["{0} items"].Value, cart.Lines.Count)</span>
        <button type="button" class="pos-icon-btn pos-icon-btn--danger" data-action="clear"
                aria-label="@L["Clear"]" title="@L["Clear"]" @(cart.IsEmpty ? "disabled" : null)>
            <partial name="_PosIcon" model='"trash"' />
        </button>
    </div>

    <div class="pos-cust" role="radiogroup" aria-label="@L["Customer"]">
        <button type="button" class="pos-cust__opt @(mode == "walkin" ? "is-active" : null)" role="radio"
                aria-checked="@(mode == "walkin" ? "true" : "false")" data-action="cust-walkin">
            <strong>@L["Walk-in"]</strong>
            <small>@L["Retail price"]</small>
        </button>
        <button type="button" class="pos-cust__opt @(mode == "wholesale" ? "is-active" : null)" role="radio"
                aria-checked="@(mode == "wholesale" ? "true" : "false")" data-action="cust-wholesale">
            <strong>@(isAr ? L["Wholesale customer"] : L["Wholesale"])</strong>
            <small>@L["Wholesale price"]</small>
        </button>
        <div class="pos-cust__reg @(hasCustomer ? "is-active has-customer" : null)">
            <button type="button" class="pos-cust__opt" role="radio" aria-checked="@(hasCustomer ? "true" : "false")"
                    data-action="customer" data-customer-id="@cart.CustomerId"
                    title="@(hasCustomer ? L["Change customer"].Value : null)">
                @if (hasCustomer)
                {
                    <strong class="pos-cust__name">@cart.CustomerName</strong>
                    <small>
                        @if (cart.CustomerType is { } ctype)
                        {
                            <partial name="_CustomerTypeBadge" model="ctype" />
                        }
                        @(wholesale ? L["Wholesale price"] : L["Retail price"])
                    </small>
                }
                else
                {
                    <strong>@L["Registered"]</strong>
                    <small>@L["Pick / add"] <kbd>F4</kbd></small>
                }
            </button>
            @if (hasCustomer)
            {
                <button type="button" class="pos-cust__clear" data-action="cust-walkin"
                        aria-label="@L["Back to walk-in customer"]" title="@L["Back to walk-in customer"]">×</button>
            }
        </div>
    </div>

    <div class="pos-cart__lines">
        @if (cart.IsEmpty)
        {
            <p class="pos-cart__empty">
                <partial name="_PosIcon" model='"barcode"' />
                <span>@L["Scan a barcode or pick a product to start."]</span>
            </p>
        }
        else
        {
            <ul>
                @foreach (var line in cart.Lines)
                {
                    <li class="pos-line @(line.IsPriceOverridden ? "is-price-edited" : null)" data-line-id="@line.Id" data-product-id="@line.ProductId"
                        data-qty="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" tabindex="-1">
                        <div class="pos-line__info">
                            <span class="pos-line__name" title="@(isAr ? line.NameAr : line.NameEn)">@(isAr ? line.NameAr : line.NameEn)</span>
                            <span class="pos-line__unit">
                                @if (Model.CanOverridePrice)
                                {
                                    @* Unit price chip: tap to edit the price for this invoice only (inline, Enter saves, Esc cancels). *@
                                    <button type="button" class="pos-price-chip" data-action="price"
                                            data-price="@line.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            title="@L["Click to change the price for this invoice only"]"
                                            aria-label="@L["Change price"]: @line.UnitPrice.ToString("N2") @currency">
                                        <span class="num">@line.UnitPrice.ToString("N2")</span>
                                        <small>@currency</small>
                                        <partial name="_PosIcon" model='"edit"' />
                                    </button>
                                }
                                else
                                {
                                    <span class="pos-price-chip is-static"><span class="num">@line.UnitPrice.ToString("N2")</span> <small>@currency</small></span>
                                }
                                @if (line.IsPriceOverridden)
                                {
                                    <span class="pos-tag pos-tag--warn">@L["Price edited"]</span>
                                }
                            </span>
                        </div>
                        <div class="pos-stepper" dir="ltr" role="group" aria-label="@L["Quantity"]">
                            <button type="button" data-action="qty" data-delta="-1" aria-label="@L["Decrease quantity"]">−</button>
                            <span class="num">@line.Quantity.ToString("0.###")</span>
                            <button type="button" data-action="qty" data-delta="1" aria-label="@L["Increase quantity"]">+</button>
                        </div>
                        <strong class="pos-line__total num">@line.LineTotal.ToString("N2")</strong>
                        <button type="button" class="pos-line__remove" data-action="remove" aria-label="@L["Remove line"]" title="@L["Remove line"]">
                            <partial name="_PosIcon" model='"trash"' />
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="pos-cart__actions">
        <button type="button" class="pos-tool-btn" data-action="discount"
                @(!Model.CanDiscount || cart.IsEmpty ? "disabled" : null)
                title="@(Model.CanDiscount ? null : L["You do not have permission to give discounts."].Value)">
            <partial name="_PosIcon" model='"tag"' /><span>@L["Discount"] · F6</span>
        </button>
        <button type="button" class="pos-tool-btn" data-action="hold" @(cart.IsEmpty ? "disabled" : null)>
            <partial name="_PosIcon" model='"pause"' /><span>@L["Hold"] · F8</span>
        </button>
        <button type="button" class="pos-tool-btn" data-action="held" @(cart.HeldCount == 0 ? "disabled" : null)>
            <partial name="_PosIcon" model='"bookmark"' /><span>@L["Held"] · F7</span>
            @if (cart.HeldCount > 0)
            {
                <span class="pos-count num">@cart.HeldCount</span>
            }
        </button>
    </div>

    <dl class="pos-cart__totals">
        <div><dt>@L["Subtotal"]</dt><dd class="num">@cart.Subtotal.ToString("N2")</dd></div>
        <div class="pos-cart__discount">
            <dt>@L["Discount"]</dt>
            <dd>
                @if (Model.CanDiscount && !cart.IsEmpty)
                {
                    <button type="button" class="pos-cart__discount-btn num" data-action="discount" title="@L["Discount"] · F6">@cart.DiscountAmount.ToString("N2")</button>
                }
                else
                {
                    <span class="num">@cart.DiscountAmount.ToString("N2")</span>
                }
            </dd>
        </div>
    </dl>
    <div class="pos-cart__total">
        <span>@L["Total"]</span>
        <strong><span class="num-total">@cart.Total.ToString("N2")</span> <small>@currency</small></strong>
    </div>
</div>
