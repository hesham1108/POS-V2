@model IReadOnlyList<CustomerOptionDto>
@if (Model.Count == 0)
{
    <p class="pos-customers__empty">@L["No customers match. Add one below."]</p>
}
else
{
    <ul>
        @foreach (var c in Model)
        {
            <li>
                <button type="button" data-customer-id="@c.Id">
                    <span>
                        <strong>@c.Name</strong>
                        <small class="num" dir="ltr">@(c.Phone ?? "")</small>
                    </span>
                    @if (c.DefaultSaleType == SaleType.Wholesale)
                    {
                        <span class="sp-status sp-status-info">@L["Wholesale"]</span>
                    }
                </button>
            </li>
        }
    </ul>
}
