@model IReadOnlyList<HeldInvoiceDto>
@if (Model.Count == 0)
{
    <p class="text-muted mb-0">@L["No held invoices."]</p>
}
else
{
    <ul class="pos-held">
        @foreach (var h in Model)
        {
            <li>
                <div>
                    <strong class="num">@h.Total.ToString("N2")</strong>
                    <span class="text-muted">· @string.Format(L["{0} items"].Value, h.LineCount) · @h.CashierDisplayName · <span class="num">@h.HeldAtUtc.ToLocalTime().ToString("HH:mm")</span></span>
                </div>
                <button type="button" class="btn btn-sm sp-btn-primary" data-resume-id="@h.Id">@L["Resume"]</button>
            </li>
        }
    </ul>
}
