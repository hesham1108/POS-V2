@model SalesIndexViewModel
@inject IPaymentMethodService PaymentMethods
@{
    ViewData["Section"] = L["Sales invoices"].Value;
    ViewData["Title"] = L["Sales invoices"].Value;
    ViewData["Subtitle"] = L["Completed sales · saved at the prices they were sold at"].Value;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var methods = await PaymentMethods.ListAsync(includeInactive: true);
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">@L["Invoice number"]</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="S-000001" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="from">@L["From"]</label>
            <input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="to">@L["To"]</label>
            <input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="method">@L["Payment method"]</label>
            <select class="form-select" id="method" name="method">
                <option value="">@L["All"]</option>
                @foreach (var m in methods)
                {
                    <option value="@m.Id" selected="@(Model.Method == (PaymentMethod)m.Id)">@(isAr ? m.NameAr : m.NameEn)</option>
                }
            </select>
        </div>
        @if (Model.ShiftId.HasValue)
        {
            <input type="hidden" name="shiftId" value="@Model.ShiftId" />
        }
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Index">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (Model.Invoices.Count == 0)
{
    var empty = (L["No invoices found"].Value, L["Completed sales from the POS appear here."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["Invoice"]</th>
                        <th>@L["Date"]</th>
                        <th>@L["Shift"]</th>
                        <th>@L["Cashier"]</th>
                        <th>@L["Customer"]</th>
                        <th>@L["Sale type"]</th>
                        <th>@L["Payment method"]</th>
                        <th class="text-end">@L["Items"]</th>
                        <th class="text-end">@L["Total"]</th>
                        <th><span class="visually-hidden">@L["Reprint receipt"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Invoices)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@i.Id" class="num">@i.InvoiceNumber</a></td>
                            <td class="num">@i.CompletedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="num">#@i.ShiftId</td>
                            <td>@i.CashierDisplayName</td>
                            <td>@(i.CustomerName ?? L["Walk-in customer"].Value)</td>
                            <td>@(i.SaleType == SaleType.Wholesale ? L["Wholesale"] : L["Retail"])</td>
                            <td><partial name="_PaymentChip" model="i.PaymentMethod" /></td>
                            <td class="text-end num">@i.LineCount</td>
                            <td class="text-end num num-total">
                                @i.Total.ToString("N2")
                                @if (i.IsFullyReturned)
                                {
                                    <div><span class="sp-status sp-status-warn">@L["Fully returned"]</span></div>
                                }
                                else if (i.IsPartlyReturned)
                                {
                                    <div><span class="sp-status sp-status-info">@L["Partly returned"]</span></div>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm sp-btn-secondary" data-print-url="@Url.Action("Sale", "Receipts", new { id = i.Id })">80</button>
                                <button type="button" class="btn btn-sm sp-btn-secondary" data-print-url="@Url.Action("SaleA4", "Receipts", new { id = i.Id })">A4</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="8">@string.Format(L["{0} invoices"].Value, Model.Invoices.Count)</th>
                        <th class="text-end num num-total">@Model.Total.ToString("N2")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
