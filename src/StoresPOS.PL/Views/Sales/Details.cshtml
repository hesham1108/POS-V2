@model SalesInvoiceDetailsDto
@{
    ViewData["Section"] = L["Sales invoices"].Value;
    ViewData["Title"] = string.Format(L["Invoice {0}"].Value, Model.InvoiceNumber);
    ViewData["Subtitle"] = Model.CompletedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm") + " · " + Model.CashierDisplayName;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">@L["Back to list"]</a>
    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.ReturnsCreate))
    {
        <a class="btn sp-btn-secondary" asp-controller="Returns" asp-action="Create" asp-route-saleId="@Model.Id">@L["Start return"]</a>
    }
    <div class="dropdown">
        <button type="button" class="btn sp-btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@L["Print"]</button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="button" class="dropdown-item" data-print-url="@Url.Action("Sale", "Receipts", new { id = Model.Id })">@L["Print 80 mm"]</button></li>
            <li><button type="button" class="dropdown-item" data-print-url="@Url.Action("SaleA4", "Receipts", new { id = Model.Id })">@L["Print A4"]</button></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" asp-controller="Receipts" asp-action="Sale" asp-route-id="@Model.Id" target="_blank">@L["Preview 80 mm"]</a></li>
            <li><a class="dropdown-item" asp-controller="Receipts" asp-action="SaleA4" asp-route-id="@Model.Id" target="_blank">@L["Preview A4"]</a></li>
        </ul>
    </div>
}

<partial name="_PageHeader" />

<div class="sp-stat-strip">
    <div class="sp-stat"><span class="sp-stat__label">@L["Total"]</span><strong class="sp-stat__value num-total">@Model.Total.ToString("N2") <small>@L["EGP"]</small></strong></div>
    <div class="sp-stat"><span class="sp-stat__label">@L["Payment method"]</span><span class="sp-stat__value"><partial name="_PaymentChip" model="Model.PaymentMethod" /></span></div>
    <div class="sp-stat"><span class="sp-stat__label">@L["Items"]</span><strong class="sp-stat__value num">@Model.Lines.Count</strong></div>
    <div class="sp-stat"><span class="sp-stat__label">@L["Shift"]</span><strong class="sp-stat__value num">#@Model.ShiftId</strong></div>
</div>

<div class="shift-layout shift-layout--wide">
    <section class="sp-card p-0">
        <div class="table-responsive">
            <table class="table sp-table">
                <thead>
                    <tr>
                        <th>@L["Item"]</th>
                        <th class="text-end">@L["Qty"]</th>
                        <th class="text-end">@L["Price"]</th>
                        <th class="text-end">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                @(isAr ? line.NameAr : line.NameEn)
                                @if (line.IsPriceOverridden)
                                {
                                    <div class="small text-muted">
                                        <span class="sp-status sp-status-warn">@L["Price edited"]</span>
                                        @string.Format(L["Catalog {0} · by {1}"].Value, line.CatalogUnitPrice.ToString("N2"), line.PriceOverriddenBy)
                                    </div>
                                }
                            </td>
                            <td class="text-end num">@line.Quantity.ToString("0.###") @line.Unit</td>
                            <td class="text-end num">@line.UnitPrice.ToString("N2")</td>
                            <td class="text-end num">@line.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="sp-card shift-summary">
        <dl class="shift-summary__rows">
            <div>
                <dt>@L["Customer"]</dt>
                <dd>
                    @if (Model.CustomerId.HasValue)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.CustomerName</a>
                    }
                    else
                    {
                        @L["Walk-in customer"]
                    }
                </dd>
            </div>
            <div><dt>@L["Sale type"]</dt><dd>@(Model.SaleType == SaleType.Wholesale ? L["Wholesale"] : L["Retail"])</dd></div>
            <div><dt>@L["Shift"]</dt><dd class="num">#@Model.ShiftId</dd></div>
            <div><dt>@L["Subtotal"]</dt><dd class="num">@Model.Subtotal.ToString("N2")</dd></div>
            <div><dt>@L["Discount"]</dt><dd class="num">@Model.DiscountAmount.ToString("N2")@(Model.DiscountBy is null ? "" : " · " + Model.DiscountBy)</dd></div>
        </dl>
        <div class="shift-summary__expected">
            <span>@L["Total"]</span>
            <strong class="num-total">@Model.Total.ToString("N2") <small>@L["EGP"]</small></strong>
        </div>
        <dl class="shift-summary__rows">
            <div><dt>@L["Payment method"]</dt><dd><partial name="_PaymentChip" model="Model.PaymentMethod" /></dd></div>
            <div><dt>@L["Paid"]</dt><dd class="num">@Model.AmountPaid.ToString("N2")</dd></div>
            <div><dt>@L["Change"]</dt><dd class="num">@Model.ChangeAmount.ToString("N2")</dd></div>
            @if (!string.IsNullOrEmpty(Model.PaymentReference))
            {
                <div><dt>@L["Reference"]</dt><dd>@Model.PaymentReference</dd></div>
            }
        </dl>
    </section>
</div>

@{
    var returns = ViewData["Returns"] as IReadOnlyList<SalesReturnListItemDto> ?? [];
}
@if (returns.Count > 0)
{
    <section class="sp-card p-4 mt-4">
        <h2 class="shift-section-title">@string.Format(L["Returns on this invoice · {0} EGP refunded"].Value, returns.Sum(x => x.TotalAmount).ToString("N2"))</h2>
        <partial name="_ReturnsTable" model="returns" />
    </section>
}
