@model ProductIndexViewModel
@using StoresPOS.PL.Extensions
@{
    var listChips = ListUrl.SearchChip(Context.Request, L["Search"].Value).Concat(ListUrl.Chips(Context.Request, ("categoryId", L["Category"].Value, v => Model.CategoryOptions.FirstOrDefault(c => c.Id.ToString() == v)?.DisplayName), ("lowStockOnly", L["Low stock only"].Value, null), ("includeInactive", L["Include inactive"].Value, null))).ToList();
    ViewData["Section"] = L["Products and categories"].Value;
    ViewData["Title"] = L["Products"].Value;
    ViewData["Subtitle"] = L["Catalog · barcode · markup pricing"].Value;
}

@section PageActions {
    <a class="btn sp-btn-primary" asp-action="Create">@L["Add product"]</a>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<partial name="_ListToolbar" model='new ListToolbarModel { Q = Model.Search, SearchPlaceholder = L["Name or barcode"].Value, Chips = listChips, Page = Model.Page, ShowSearch = true }' />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <input type="hidden" name="q" value="@Model.Search" />
        }
        <div class="sp-filter-row__field">
            <label class="form-label" for="categoryId">@L["Category"]</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">@L["All"]</option>
                @foreach (var opt in Model.CategoryOptions)
                {
                    if (Model.CategoryId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <label class="sp-filter-row__check form-check" for="lowStockOnly">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly"
                   @(Model.LowStockOnly ? "checked" : null) />
            <span class="form-check-label">@L["Low stock"]</span>
        </label>
        <label class="sp-filter-row__check form-check" for="includeInactive">
            <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                   @(Model.IncludeInactive ? "checked" : null) />
            <span class="form-check-label">@L["Inactive"]</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive sp-table-scroll">
        <table class="table sp-table">
            <thead>
                <tr>
                    <partial name="_SortTh" model='new SortHeader("NameEn", L["Product"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("Barcode", L["Barcode"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("CategoryNameEn", L["Category"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("PurchasePrice", L["Cost"].Value, Model.Page, Numeric: true)' />
                    <partial name="_SortTh" model='new SortHeader("RetailPrice", L["Retail"].Value, Model.Page, Numeric: true)' />
                    <partial name="_SortTh" model='new SortHeader("WholesalePrice", L["Wholesale"].Value, Model.Page, Numeric: true)' />
                    <partial name="_SortTh" model='new SortHeader("StockQuantity", L["Stock"].Value, Model.Page, Numeric: true)' />
                    <th>@L["Status"]</th>
                    <th class="col-num">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Products.Count == 0)
            {
                <tr>
                    <td colspan="9">
                        <partial name="_EmptyState" model='("No products found", "Adjust filters or add a product to the catalog.")' />
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@Ui.Name(item.NameEn, item.NameAr)</div>
                            @if (Ui.IsArabic)
                            {
                                <div class="small text-muted" lang="en" dir="ltr">@item.NameEn</div>
                            }
                            else
                            {
                                <div class="small text-muted" lang="ar" dir="rtl">@item.NameAr</div>
                            }
                            <div class="small text-muted">@item.Unit</div>
                        </td>
                        <td class="font-monospace">@(item.Barcode ?? "—")</td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="col-num font-monospace">@item.PurchasePrice.ToString("N2")</td>
                        <td class="col-num font-monospace">@item.RetailPrice.ToString("N2")</td>
                        <td class="col-num font-monospace">@item.WholesalePrice.ToString("N2")</td>
                        <td class="col-num">
                            <span class="font-monospace">@item.StockQuantity.ToString("0.###")</span>
                            @if (item.IsLowStock)
                            {
                                <span class="sp-status sp-status-warn" style="margin-inline-start:0.35rem">@L["Low"]</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-status sp-status-ok">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">@L["Inactive"]</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">@L["View"]</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Deactivate"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
        <partial name="_Pager" model="Model.Page" />
</div>
