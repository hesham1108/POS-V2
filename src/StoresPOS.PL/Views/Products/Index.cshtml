@model ProductIndexViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Products</h1>
        <p class="text-muted mb-0">Catalog · barcode · markup pricing</p>
    </div>
    <a class="btn sp-btn-primary" asp-action="Create">Add product</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name or barcode" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="categoryId">Category</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">All</option>
                @foreach (var opt in Model.CategoryOptions)
                {
                    if (Model.CategoryId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly"
                       @(Model.LowStockOnly ? "checked" : null) />
                <label class="form-check-label" for="lowStockOnly">Low stock</label>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                       @(Model.IncludeInactive ? "checked" : null) />
                <label class="form-check-label" for="includeInactive">Inactive</label>
            </div>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn sp-btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Barcode</th>
                    <th>Category</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Retail</th>
                    <th class="text-end">Wholesale</th>
                    <th class="text-end">Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Products.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">No products match this filter.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.NameEn</div>
                            <div class="small text-muted" dir="rtl">@item.NameAr</div>
                            <div class="small text-muted">@item.Unit</div>
                        </td>
                        <td class="font-monospace">@(item.Barcode ?? "—")</td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="text-end font-monospace">@item.PurchasePrice.ToString("N2")</td>
                        <td class="text-end font-monospace">@item.RetailPrice.ToString("N2")</td>
                        <td class="text-end font-monospace">@item.WholesalePrice.ToString("N2")</td>
                        <td class="text-end">
                            <span class="font-monospace">@item.StockQuantity.ToString("0.###")</span>
                            @if (item.IsLowStock)
                            {
                                <span class="badge text-bg-warning ms-1">Low</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-badge"><span class="sp-badge-dot"></span> Active</span>
                            }
                            else
                            {
                                <span class="text-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
