@model ProductIndexViewModel
@{
    ViewData["Section"] = "Products and categories";
    ViewData["Title"] = "Products";
    ViewData["Subtitle"] = "Catalog · barcode · markup pricing";
}

@section PageActions {
    <a class="btn sp-btn-primary" asp-action="Create">Add product</a>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name or barcode" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="categoryId">Category</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">All</option>
                @foreach (var opt in Model.CategoryOptions)
                {
                    if (Model.CategoryId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <label class="sp-filter-row__check form-check" for="lowStockOnly">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly"
                   @(Model.LowStockOnly ? "checked" : null) />
            <span class="form-check-label">Low stock</span>
        </label>
        <label class="sp-filter-row__check form-check" for="includeInactive">
            <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                   @(Model.IncludeInactive ? "checked" : null) />
            <span class="form-check-label">Inactive</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Barcode</th>
                    <th>Category</th>
                    <th class="col-num">Cost</th>
                    <th class="col-num">Retail</th>
                    <th class="col-num">Wholesale</th>
                    <th class="col-num">Stock</th>
                    <th>Status</th>
                    <th class="col-num">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Products.Count == 0)
            {
                <tr>
                    <td colspan="9">
                        <partial name="_EmptyState" model='("No products found", "Adjust filters or add a product to the catalog.")' />
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.NameEn</div>
                            <div class="small text-muted" dir="rtl">@item.NameAr</div>
                            <div class="small text-muted">@item.Unit</div>
                        </td>
                        <td class="font-monospace">@(item.Barcode ?? "—")</td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="col-num font-monospace">@item.PurchasePrice.ToString("N2")</td>
                        <td class="col-num font-monospace">@item.RetailPrice.ToString("N2")</td>
                        <td class="col-num font-monospace">@item.WholesalePrice.ToString("N2")</td>
                        <td class="col-num">
                            <span class="font-monospace">@item.StockQuantity.ToString("0.###")</span>
                            @if (item.IsLowStock)
                            {
                                <span class="sp-status sp-status-warn" style="margin-inline-start:0.35rem">Low</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-status sp-status-ok">Active</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">Inactive</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
