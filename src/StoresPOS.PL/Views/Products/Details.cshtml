@model ProductListItemViewModel
@{
    ViewData["Title"] = Model.NameEn;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">@Model.NameEn</h1>
        <p class="text-muted mb-0" dir="rtl">@Model.NameAr</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn sp-btn-secondary" asp-action="Index">Back</a>
        <a class="btn sp-btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="sp-card p-4" style="max-width: 720px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Barcode</dt>
        <dd class="col-sm-8 font-monospace">@(Model.Barcode ?? "—")</dd>

        <dt class="col-sm-4">Unit</dt>
        <dd class="col-sm-8">@Model.Unit</dd>

        <dt class="col-sm-4">Category</dt>
        <dd class="col-sm-8">@(Model.CategoryName ?? "—")</dd>

        <dt class="col-sm-4">Purchase price</dt>
        <dd class="col-sm-8 font-monospace">@Model.PurchasePrice.ToString("N2") EGP</dd>

        <dt class="col-sm-4">Retail</dt>
        <dd class="col-sm-8 font-monospace">@Model.RetailPrice.ToString("N2") EGP</dd>

        <dt class="col-sm-4">Wholesale</dt>
        <dd class="col-sm-8 font-monospace">@Model.WholesalePrice.ToString("N2") EGP</dd>

        <dt class="col-sm-4">Stock</dt>
        <dd class="col-sm-8">
            <span class="font-monospace">@Model.StockQuantity.ToString("0.###")</span>
            <span class="text-muted">(threshold @Model.LowStockThreshold.ToString("0.###"))</span>
            @if (Model.IsLowStock)
            {
                <span class="badge text-bg-warning ms-1">Low stock</span>
            }
        </dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</div>
