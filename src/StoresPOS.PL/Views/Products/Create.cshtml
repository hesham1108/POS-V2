@model ProductFormViewModel
@{
    ViewData["Section"] = L["Products and categories"].Value;
    ViewData["Title"] = L["Add product"].Value;
    ViewData["Subtitle"] = L["Edit sell price or markup % — the other updates automatically"].Value;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">@L["Cancel"]</a>
    <button type="submit" form="product-form" class="btn sp-btn-primary">@L["Save product"]</button>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

<partial name="_ProductForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-pricing.js" asp-append-version="true"></script>
}
