@model ProductFormViewModel
@{
    ViewData["Title"] = "Add product";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Add product</h1>
    <p class="text-muted mb-0">Edit sell price or markup % — the other updates automatically</p>
</div>

<partial name="_ProductForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-pricing.js" asp-append-version="true"></script>
}
