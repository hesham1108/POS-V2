@model ProductFormViewModel
@{
    ViewData["Section"] = "Products and categories";
    ViewData["Title"] = "Edit product";
    ViewData["Subtitle"] = "Catalog price changes do not rewrite historical invoices";
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">Cancel</a>
    <button type="submit" form="product-form" class="btn sp-btn-primary">Save product</button>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

<partial name="_ProductForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-pricing.js" asp-append-version="true"></script>
}
