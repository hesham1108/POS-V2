@model ProductFormViewModel

<div class="sp-form-wrap">
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post" id="product-form" class="sp-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <section class="sp-card sp-form-section">
        <header class="sp-form-section__head">
            <span class="sp-form-section__icon"><partial name="_PosIcon" model='"box"' /></span>
            <div>
                <h2 class="sp-form-section__title">@L["Product details"]</h2>
                <p class="sp-form-section__hint">@L["Names, barcode, unit and category"]</p>
            </div>
        </header>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" dir="rtl" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Barcode" class="form-label"></label>
                <input asp-for="Barcode" class="form-control font-monospace" placeholder="@L["Scan or type barcode"]" />
            </div>
            <div class="col-md-4">
                <label asp-for="Unit" class="form-label"></label>
                <input asp-for="Unit" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">@L["— none —"]</option>
                    @foreach (var opt in Model.CategoryOptions)
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="LowStockThreshold" class="form-label"></label>
                <input asp-for="LowStockThreshold" class="form-control font-monospace" step="0.001" />
            </div>
        </div>

        </section>

        <section class="sp-card sp-form-section">
        <header class="sp-form-section__head">
            <span class="sp-form-section__icon"><partial name="_PosIcon" model='"coins"' /></span>
            <div>
                <h2 class="sp-form-section__title">@L["Pricing"]</h2>
                <p class="sp-form-section__hint">@L["Edit sell price or markup % — the other updates automatically"]</p>
            </div>
        </header>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="PurchasePrice" class="form-label"></label>
                <input asp-for="PurchasePrice" class="form-control font-monospace" id="PurchasePrice" step="0.01" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="sp-pricing-panel">
                    <h3 class="sp-pricing-panel__title">@L["Retail"]</h3>
                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="RetailMarkupPercent" class="form-label"></label>
                            <input asp-for="RetailMarkupPercent" class="form-control font-monospace" id="RetailMarkupPercent" step="0.0001" />
                        </div>
                        <div class="col-6">
                            <label asp-for="RetailPrice" class="form-label"></label>
                            <input asp-for="RetailPrice" class="form-control font-monospace" id="RetailPrice" step="0.01" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="sp-pricing-panel">
                    <h3 class="sp-pricing-panel__title">@L["Wholesale"]</h3>
                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="WholesaleMarkupPercent" class="form-label"></label>
                            <input asp-for="WholesaleMarkupPercent" class="form-control font-monospace" id="WholesaleMarkupPercent" step="0.0001" />
                        </div>
                        <div class="col-6">
                            <label asp-for="WholesalePrice" class="form-label"></label>
                            <input asp-for="WholesalePrice" class="form-control font-monospace" id="WholesalePrice" step="0.01" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Id.HasValue)
        {
            <p class="small text-muted mt-3 mb-0">
                @L["Current stock:"] <span class="font-monospace">@Model.StockQuantity.ToString("0.###")</span>
                (@L["changes with purchases, sales and stock adjustments"])
            </p>
        }

        </section>

        <partial name="_FormActions" model="@(Url.Action("Index"))" />
    </form>
</div>
