@model PurchaseIndexViewModel
@using StoresPOS.PL.Extensions
@{
    var listChips = ListUrl.SearchChip(Context.Request, L["Search"].Value).Concat(ListUrl.Chips(Context.Request, ("supplierId", L["Supplier"].Value, v => Model.SupplierOptions.FirstOrDefault(x => x.Id.ToString() == v)?.DisplayName), ("status", L["Status"].Value, null))).ToList();
    ViewData["Section"] = L["Purchase invoices"].Value;
    ViewData["Title"] = L["Purchase invoices"].Value;
    ViewData["Subtitle"] = L["Supplier invoices · stock & price updates on confirm"].Value;
}

@section PageActions {
    <a class="btn sp-btn-primary" asp-action="Create">@L["New purchase"]</a>
}

<partial name="_PageHeader" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<partial name="_ListToolbar" model='new ListToolbarModel { Q = Model.Search, SearchPlaceholder = L["Invoice # or supplier"].Value, Chips = listChips, Page = Model.Page, ShowSearch = true }' />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <input type="hidden" name="q" value="@Model.Search" />
        }
        <div class="sp-filter-row__field">
            <label class="form-label" for="supplierId">@L["Supplier"]</label>
            <select class="form-select" id="supplierId" name="supplierId">
                <option value="">@L["All"]</option>
                @foreach (var opt in Model.SupplierOptions)
                {
                    if (Model.SupplierId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="status">@L["Status"]</label>
            <select class="form-select" id="status" name="status">
                <option value="">@L["All"]</option>
                @if (Model.Status == PurchaseInvoiceStatus.Draft)
                {
                    <option value="@((int)PurchaseInvoiceStatus.Draft)" selected>@L["Draft"]</option>
                }
                else
                {
                    <option value="@((int)PurchaseInvoiceStatus.Draft)">@L["Draft"]</option>
                }
                @if (Model.Status == PurchaseInvoiceStatus.Confirmed)
                {
                    <option value="@((int)PurchaseInvoiceStatus.Confirmed)" selected>@L["Confirmed"]</option>
                }
                else
                {
                    <option value="@((int)PurchaseInvoiceStatus.Confirmed)">@L["Confirmed"]</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive sp-table-scroll">
        <table class="table sp-table">
            <thead>
                <tr>
                    <partial name="_SortTh" model='new SortHeader("InvoiceNumber", L["Invoice"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("SupplierNameEn", L["Supplier"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("InvoiceDate", L["Date"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("LineCount", L["Lines"].Value, Model.Page, Numeric: true)' />
                    <partial name="_SortTh" model='new SortHeader("SubTotal", L["Total"].Value, Model.Page, Numeric: true)' />
                    <partial name="_SortTh" model='new SortHeader("Status", L["Status"].Value, Model.Page)' />
                    <th class="col-num">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Invoices.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='(L["No purchase invoices"].Value, L["Create a draft purchase to receive stock from a supplier."].Value)' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Invoices)
                {
                    <tr>
                        <td class="font-monospace">@item.InvoiceNumber</td>
                        <td>@item.SupplierName</td>
                        <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td class="col-num">@item.LineCount</td>
                        <td class="col-num font-monospace">@item.SubTotal.ToString("N2")</td>
                        <td>
                            @if (item.Status == PurchaseInvoiceStatus.Confirmed)
                            {
                                <span class="sp-status sp-status-ok">@L["Confirmed"]</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">@L["Draft"]</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">@L["View"]</a>
                            @if (item.Status == PurchaseInvoiceStatus.Draft)
                            {
                                <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
        <partial name="_Pager" model="Model.Page" />
</div>
