@model PurchaseIndexViewModel
@{
    ViewData["Section"] = "Purchase invoices";
    ViewData["Title"] = "Purchase invoices";
    ViewData["Subtitle"] = "Supplier invoices · stock & price updates on confirm";
}

@section PageActions {
    <a class="btn sp-btn-primary" asp-action="Create">New purchase</a>
}

<partial name="_PageHeader" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Invoice # or supplier" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="supplierId">Supplier</label>
            <select class="form-select" id="supplierId" name="supplierId">
                <option value="">All</option>
                @foreach (var opt in Model.SupplierOptions)
                {
                    if (Model.SupplierId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="">All</option>
                @if (Model.Status == PurchaseInvoiceStatus.Draft)
                {
                    <option value="@((int)PurchaseInvoiceStatus.Draft)" selected>Draft</option>
                }
                else
                {
                    <option value="@((int)PurchaseInvoiceStatus.Draft)">Draft</option>
                }
                @if (Model.Status == PurchaseInvoiceStatus.Confirmed)
                {
                    <option value="@((int)PurchaseInvoiceStatus.Confirmed)" selected>Confirmed</option>
                }
                else
                {
                    <option value="@((int)PurchaseInvoiceStatus.Confirmed)">Confirmed</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th class="col-num">Lines</th>
                    <th class="col-num">Total</th>
                    <th>Status</th>
                    <th class="col-num">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Invoices.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='("No purchase invoices", "Create a draft purchase to receive stock from a supplier.")' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Invoices)
                {
                    <tr>
                        <td class="font-monospace">@item.InvoiceNumber</td>
                        <td>@item.SupplierName</td>
                        <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td class="col-num">@item.LineCount</td>
                        <td class="col-num font-monospace">@item.SubTotal.ToString("N2")</td>
                        <td>
                            @if (item.Status == PurchaseInvoiceStatus.Confirmed)
                            {
                                <span class="sp-status sp-status-ok">Confirmed</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">Draft</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            @if (item.Status == PurchaseInvoiceStatus.Draft)
                            {
                                <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
