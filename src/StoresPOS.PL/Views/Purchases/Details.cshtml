@model PurchaseDetailsViewModel
@{
    ViewData["Section"] = "Purchase invoices";
    ViewData["Title"] = Model.InvoiceNumber;
    ViewData["Subtitle"] = $"{Model.SupplierName} · {Model.InvoiceDate:yyyy-MM-dd}";
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">Back</a>
    @if (Model.Status == PurchaseInvoiceStatus.Draft)
    {
        <a class="btn sp-btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Confirm this purchase? Stock and selling prices will update.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn sp-btn-primary">Confirm</button>
        </form>
    }
}

<partial name="_PageHeader" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <div class="text-muted small">Status</div>
            <div>
                @if (Model.Status == PurchaseInvoiceStatus.Confirmed)
                {
                    <span class="sp-badge"><span class="sp-badge-dot"></span> Confirmed</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Draft</span>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="text-muted small">Created by</div>
            <div>@Model.CreatedByUsername</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted small">Confirmed by</div>
            <div>@(Model.ConfirmedByUsername ?? "—")</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted small">Total</div>
            <div class="fs-4 fw-bold font-monospace" style="color: var(--sp-primary);">@Model.SubTotal.ToString("N2") EGP</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="col-12">
                <div class="text-muted small">Notes</div>
                <div>@Model.Notes</div>
            </div>
        }
    </div>
</div>

<div class="sp-card p-0 overflow-hidden">
    <table class="table mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th>Unit</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Unit cost</th>
                <th class="text-end">Line total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var line in Model.Items)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@line.ProductNameEn</div>
                    <div class="small text-muted" dir="rtl">@line.ProductNameAr</div>
                </td>
                <td>@line.Unit</td>
                <td class="text-end font-monospace">@line.Quantity.ToString("0.###")</td>
                <td class="text-end font-monospace">@line.UnitCost.ToString("N2")</td>
                <td class="text-end font-monospace">@line.LineTotal.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
