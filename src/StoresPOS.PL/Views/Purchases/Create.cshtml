@model PurchaseFormViewModel
@{
    ViewData["Title"] = "New purchase";
}

<div class="mb-4">
    <h1 class="h3 mb-1">New purchase</h1>
    <p class="text-muted mb-0">Save as draft or confirm immediately to update stock and prices</p>
</div>

<partial name="_PurchaseForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/purchase-form.js" asp-append-version="true"></script>
}
