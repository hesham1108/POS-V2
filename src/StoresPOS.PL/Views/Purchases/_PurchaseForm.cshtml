@model PurchaseFormViewModel

<div class="sp-card p-4">
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post" id="purchase-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">— Select —</option>
                    @foreach (var opt in Model.SupplierOptions)
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InvoiceDate" class="form-label"></label>
                <input asp-for="InvoiceDate" class="form-control" type="date" />
            </div>
            <div class="col-md-5">
                <label asp-for="InvoiceNumber" class="form-label"></label>
                <input asp-for="InvoiceNumber" class="form-control font-monospace" placeholder="Auto if empty" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Lines</h2>
            <button type="button" class="btn btn-sm sp-btn-secondary" id="add-line">Add line</button>
        </div>

        <div class="table-responsive mb-3">
            <table class="table align-middle" id="purchase-lines">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 240px;">Product</th>
                        <th style="width: 120px;">Qty</th>
                        <th style="width: 140px;">Unit cost</th>
                        <th style="width: 120px;" class="text-end">Line</th>
                        <th style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <tr class="purchase-line">
                        <td>
                            <select name="Items[@i].ProductId" class="form-select product-select" data-index="@i">
                                <option value="">— Select —</option>
                                @foreach (var opt in Model.ProductOptions)
                                {
                                    if (Model.Items[i].ProductId == opt.Id)
                                    {
                                        <option value="@opt.Id" selected
                                                data-cost="@opt.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            @opt.DisplayName
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Id"
                                                data-cost="@opt.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            @opt.DisplayName
                                        </option>
                                    }
                                }
                            </select>
                        </td>
                        <td>
                            <input name="Items[@i].Quantity" class="form-control font-monospace qty-input"
                                   value="@Model.Items[i].Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   step="0.001" min="0.001" />
                        </td>
                        <td>
                            <input name="Items[@i].UnitCost" class="form-control font-monospace cost-input"
                                   value="@Model.Items[i].UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   step="0.01" min="0" />
                        </td>
                        <td class="text-end font-monospace line-total">0.00</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Remove">&times;</button>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Subtotal</td>
                        <td class="text-end fw-bold font-monospace" id="subtotal">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="form-check mb-3">
            <input asp-for="ConfirmOnSave" class="form-check-input" />
            <label asp-for="ConfirmOnSave" class="form-check-label">
                Confirm on save (increase stock &amp; recalculate sell prices)
            </label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn sp-btn-primary">Save</button>
            <a class="btn sp-btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

<template id="purchase-line-template">
    <tr class="purchase-line">
        <td>
            <select name="Items[__IX__].ProductId" class="form-select product-select">
                <option value="">— Select —</option>
                @foreach (var opt in Model.ProductOptions)
                {
                    <option value="@opt.Id"
                            data-cost="@opt.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @opt.DisplayName
                    </option>
                }
            </select>
        </td>
        <td>
            <input name="Items[__IX__].Quantity" class="form-control font-monospace qty-input" value="1" step="0.001" min="0.001" />
        </td>
        <td>
            <input name="Items[__IX__].UnitCost" class="form-control font-monospace cost-input" value="0" step="0.01" min="0" />
        </td>
        <td class="text-end font-monospace line-total">0.00</td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Remove">&times;</button>
        </td>
    </tr>
</template>
