@model CustomerFormViewModel

<div class="sp-card p-4" style="max-width: 720px;">
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post" class="sp-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control num" inputmode="tel" dir="ltr" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerType" class="form-label"></label>
                <select asp-for="CustomerType" class="form-select" data-customer-type>
                    <option value="@((int)CustomerType.Retail)">@L["Retail"]</option>
                    <option value="@((int)CustomerType.Wholesale)">@L["Wholesale"]</option>
                    <option value="@((int)CustomerType.Company)">@L["Company"]</option>
                </select>
                <div class="form-text">@L["Used to sort customers in lists and reports. It does not change prices by itself."]</div>
            </div>
            <div class="col-md-6">
                <label asp-for="DefaultSaleType" class="form-label"></label>
                <select asp-for="DefaultSaleType" class="form-select" data-price-level data-touched="@(Model.Id.HasValue ? "1" : "0")">
                    <option value="@((int)SaleType.Retail)">@L["Retail price"]</option>
                    <option value="@((int)SaleType.Wholesale)">@L["Wholesale price"]</option>
                </select>
                <div class="form-text">@L["Picking this customer in the POS switches the invoice to this price list."]</div>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <partial name="_FormActions" model="@(Model.Id.HasValue ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))" />
    </form>
</div>

@* New customer: the price level follows the type until the user changes it by hand. *@
<script>
    (() => {
        const type = document.querySelector("[data-customer-type]");
        const level = document.querySelector("[data-price-level]");
        if (!type || !level) return;
        level.addEventListener("change", () => { level.dataset.touched = "1"; });
        type.addEventListener("change", () => {
            if (level.dataset.touched === "1") return;
            level.value = type.value === "2" ? "2" : "1";
        });
    })();
</script>
