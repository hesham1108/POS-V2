@model SettingsPageViewModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@{
    // Phase 18: grouped side navigation; every tab is its own partial and loads only its own data.
    var groups = new (string Title, (string Tab, string Label, string Icon)[] Items)[]
    {
        (L["Store"].Value, new[]
        {
            ("store", L["Store profile"].Value, "home"),
            ("sales", L["Sales and tax"].Value, "receipt"),
            ("numbering", L["Numbering"].Value, "tag")
        }),
        (L["Appearance and language"].Value, new[]
        {
            ("appearance", L["Appearance"].Value, "edit"),
            ("language", L["Language"].Value, "globe")
        }),
        (L["Printing"].Value, new[]
        {
            ("printing", L["Printers and defaults"].Value, "printer"),
            ("templates", L["Print templates"].Value, "file")
        }),
        (L["Data"].Value, new[]
        {
            ("backup", L["Database and backup"].Value, "layers"),
            ("license", L["License"].Value, "lock")
        })
    };

    var formTabs = new[] { "store", "appearance", "sales", "numbering", "printing", "language", "backup" };
    var isFormTab = formTabs.Contains(Model.Tab);

    // Search index: every field label with the tab it lives on (field id = Form_<Property>).
    var index = new List<object>();
    foreach (var prop in typeof(StoreSettingsFormViewModel).GetProperties())
    {
        var tab = prop.GetCustomAttribute<SettingsTabAttribute>()?.Tabs.FirstOrDefault();
        var display = prop.GetCustomAttribute<DisplayAttribute>()?.Name;
        if (tab is null || display is null)
        {
            continue;
        }

        index.Add(new { label = L[display].Value, tab, id = "Form_" + prop.Name });
    }

    index.Add(new { label = L["Printers"].Value, tab = "printing", id = "printers-section" });
    index.Add(new { label = L["Document defaults"].Value, tab = "printing", id = "document-defaults" });
    index.Add(new { label = L["Shift report"].Value, tab = "printing", id = "document-defaults" });
    index.Add(new { label = L["Receipt look"].Value, tab = "printing", id = "receipt-look" });
    index.Add(new { label = L["Print templates"].Value, tab = "templates", id = "template-editor" });
    index.Add(new { label = L["Return policy (Arabic)"].Value, tab = "templates", id = "template-editor" });
    index.Add(new { label = L["Backup now"].Value, tab = "backup", id = "backup-list" });
    index.Add(new { label = L["Device ID"].Value, tab = "license", id = "license-status" });
    index.Add(new { label = L["UI logo"].Value, tab = "appearance", id = "Form_UiLogoRelativePath" });
    index.Add(new { label = L["Favicon"].Value, tab = "appearance", id = "Form_FaviconRelativePath" });
    index.Add(new { label = L["A4 logo"].Value, tab = "store", id = "Form_LogoRelativePath" });
    var indexJson = System.Text.Json.JsonSerializer.Serialize(index);
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-controller="PaymentMethods" asp-action="Index">@L["Payment methods"]</a>
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="sp-settings" data-tab="@Model.Tab">
    <aside class="sp-settings__nav" aria-label="@L["Settings"]">
        <div class="sp-settings__search">
            <input type="search" class="form-control" id="settings-search" autocomplete="off"
                   placeholder="@L["Search settings"]" aria-label="@L["Search settings"]"
                   data-index="@indexJson" data-base-url="@Url.Action("Index", "Settings")"
                   data-empty="@L["No matching settings"]" />
            <div class="sp-settings__results" id="settings-search-results" role="listbox" hidden></div>
        </div>
        @foreach (var g in groups)
        {
            <div class="sp-settings__group">
                <div class="sp-settings__group-title">@g.Title</div>
                @foreach (var item in g.Items)
                {
                    <a class="sp-settings__link @(Model.Tab == item.Tab ? "is-active" : "")"
                       asp-action="Index" asp-route-tab="@item.Tab"
                       aria-current="@(Model.Tab == item.Tab ? "page" : null)">
                        <partial name="_PosIcon" model="item.Icon" /><span>@item.Label</span>
                    </a>
                }
            </div>
        }
    </aside>

    <div class="sp-settings__body">
        @if (isFormTab)
        {
            <form asp-action="Save" method="post" enctype="multipart/form-data" id="settings-form" class="sp-settings__form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="tab" value="@Model.Tab" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="sp-card p-4">
                    @switch (Model.Tab)
                    {
                        case "store": <partial name="_Store" />; break;
                        case "sales": <partial name="_Sales" />; break;
                        case "numbering": <partial name="_Numbering" />; break;
                        case "appearance": <partial name="_Appearance" />; break;
                        case "language": <partial name="_Language" />; break;
                        case "printing": <partial name="_Printing" />; break;
                        case "backup": <partial name="_Backup" />; break;
                    }
                </div>

                <div class="sp-savebar" id="settings-savebar">
                    <span class="sp-savebar__state" id="settings-dirty" data-clean="@L["All changes saved"]" data-dirty="@L["Unsaved changes"]">@L["All changes saved"]</span>
                    <button type="reset" class="btn sp-btn-secondary" id="settings-discard" disabled>@L["Discard"]</button>
                    <button type="submit" class="btn sp-btn-primary" id="settings-save" data-saving="@L["Saving…"]">@L["Save"]</button>
                </div>
            </form>
        }

        @if (Model.Tab == "templates")
        {
            <partial name="_Templates" />
        }
        else if (Model.Tab == "backup")
        {
            <partial name="_BackupList" />
        }
        else if (Model.Tab == "license")
        {
            <partial name="_License" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="settings-i18n" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            leave = L["You have unsaved changes. Leave this page?"].Value,
            printed = L["Printed"].Value,
            failed = L["Print failed"].Value,
            noPrinters = L["No printers found"].Value
        }))
    </script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    @if (Model.Tab == "templates")
    {
        <script src="~/js/templates.js" asp-append-version="true"></script>
    }
}
