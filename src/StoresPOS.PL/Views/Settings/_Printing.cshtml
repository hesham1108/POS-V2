@model SettingsPageViewModel
@using StoresPOS.BLL.Models
@{
    var f = Model.Form;
    var docs = new (string Key, string Label, string Field, StoresPOS.BLL.Models.DocumentPrintSettings Value, PrintDocumentType Type)[]
    {
        ("sale", L["Sales invoice"].Value, "SalePrint", f.SalePrint, PrintDocumentType.Sale),
        ("return", L["Return slip"].Value, "ReturnPrint", f.ReturnPrint, PrintDocumentType.Return),
        ("purchase", L["Purchase invoice"].Value, "PurchasePrint", f.PurchasePrint, PrintDocumentType.Purchase),
        ("shift", L["Shift report"].Value, "ShiftPrint", f.ShiftPrint, PrintDocumentType.Shift)
    };
    // Resolve the effective format (own value or the older store-wide fallback) so the table shows what prints today.
    var resolved = SettingsMapper.Map<StoreSettings>(f);
}

<section class="sp-settings-section" id="printers-section">
    <h2 class="sp-settings-section__title">@L["Printers"]</h2>
    <p class="sp-settings-section__sub">@L["Pay and print sends silently to these printers (no browser dialog). Save settings first."]</p>

    <div class="sp-printer-grid" data-printers-url="@Url.Action("Printers", "Settings")" data-test-url="@Url.Action("TestSilentPrint", "Settings")">
        @foreach (var (field, labelKey, value, format) in new[]
        {
            ("ThermalPrinterName", "Thermal printer (80 mm)", f.ThermalPrinterName, "80mm"),
            ("A4PrinterName", "A4 printer", f.A4PrinterName, "A4"),
            ("DefaultPrinterName", "Fallback printer", f.DefaultPrinterName, "")
        })
        {
            <div class="sp-printer-row">
                <label class="form-label" for="Form_@field">@L[labelKey]</label>
                <div class="input-group">
                    <select class="form-select" id="Form_@field" name="Form.@field" data-printer-select data-saved="@value">
                        <option value="">@(field == "DefaultPrinterName" ? L["Windows default"] : L["Use fallback printer"])</option>
                        @if (!string.IsNullOrWhiteSpace(value))
                        {
                            <option value="@value" selected>@value</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(format))
                    {
                        <button type="button" class="btn sp-btn-secondary" data-printer-test data-format="@format" data-target="Form_@field">@L["Test print"]</button>
                    }
                </div>
            </div>
        }
        <div class="sp-printer-status">
            <button type="button" class="btn btn-sm sp-btn-secondary" id="printer-refresh">@L["Refresh"]</button>
            <span class="text-muted small" id="printer-status" data-loading="@L["Loading printers…"]" data-windows-default="@L["Windows default"]">@L["Loading printers…"]</span>
            <div id="printer-test-result" class="small text-muted w-100" role="status"></div>
        </div>
    </div>
</section>

<section class="sp-settings-section" id="document-defaults">
    <h2 class="sp-settings-section__title">@L["Document defaults"]</h2>
    <p class="sp-settings-section__sub">@L["Paper size, automatic printing and copies for each document."]</p>
    <div class="table-responsive">
        <table class="table sp-table sp-doc-defaults">
            <thead>
                <tr>
                    <th>@L["Document"]</th>
                    <th>@L["Paper size"]</th>
                    <th>@L["Print automatically"]</th>
                    <th class="col-num">@L["Copies"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in docs)
                {
                    var current = resolved.FormatFor(d.Type);
                    <tr>
                        <td class="fw-semibold">@d.Label</td>
                        <td>
                            <div class="btn-group btn-group-sm sp-segmented" role="group" aria-label="@d.Label">
                                @foreach (var opt in new[] { PrintFormats.Mm80, PrintFormats.A4 })
                                {
                                    var id = $"doc-{d.Key}-{opt}";
                                    <input type="radio" class="btn-check" name="Form.@(d.Field).Format" id="@id" value="@opt" checked="@(current == opt)" />
                                    <label class="btn sp-btn-secondary" for="@id">@(opt == PrintFormats.A4 ? "A4" : "80 mm")</label>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="doc-@d.Key-auto" name="Form.@(d.Field).AutoPrint" value="true" checked="@d.Value.AutoPrint" />
                                <input type="hidden" name="Form.@(d.Field).AutoPrint" value="false" />
                                <label class="visually-hidden" for="doc-@d.Key-auto">@L["Print automatically"]</label>
                            </div>
                        </td>
                        <td class="col-num">
                            <input type="number" class="form-control form-control-sm num sp-copies" name="Form.@(d.Field).Copies" value="@d.Value.Copies" min="1" max="5" inputmode="numeric" aria-label="@L["Copies"]" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="form-text">@L["Copies apply to silent printing. Browser printing prints one copy."]</div>
</section>

<section class="sp-settings-section" id="receipt-look">
    <h2 class="sp-settings-section__title">@L["Receipt look"]</h2>
    <div class="row g-4">
        <div class="col-xl-5">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Form.PaperWidthMm" class="form-label"></label>
                    <select asp-for="Form.PaperWidthMm" class="form-select preview-field">
                        <option value="80">80</option>
                        <option value="58">58</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.ReceiptLanguage" class="form-label"></label>
                    <select asp-for="Form.ReceiptLanguage" class="form-select preview-field">
                        <option value="ar">العربية</option>
                        <option value="en">English</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.ReceiptDigits" class="form-label"></label>
                    <select asp-for="Form.ReceiptDigits" class="form-select preview-field">
                        <option value="western">123</option>
                        <option value="arabic">١٢٣</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.ReceiptFontScale" class="form-label"></label>
                    <input asp-for="Form.ReceiptFontScale" class="form-control num preview-field" step="0.05" inputmode="decimal" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.ReceiptFooterEn" class="form-label"></label>
                    <input asp-for="Form.ReceiptFooterEn" class="form-control preview-field" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.ReceiptFooterAr" class="form-label"></label>
                    <input asp-for="Form.ReceiptFooterAr" class="form-control preview-field" dir="rtl" />
                </div>
                <div class="col-12">
                    <p class="form-text mb-0">@L["Which parts appear on each document (logo, address, columns, totals, signatures…) is set per document in Print templates."]
                        <a asp-action="Index" asp-route-tab="templates">@L["Open print templates"]</a></p>
                </div>
            </div>
        </div>
        <div class="col-xl-7">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small">@L["Preview"]</span>
                <div class="btn-group btn-group-sm sp-segmented" role="group" aria-label="@L["Preview"]">
                    <input type="radio" class="btn-check" name="preview-format" id="preview-80" value="80mm" checked />
                    <label class="btn sp-btn-secondary" for="preview-80">80 mm</label>
                    <input type="radio" class="btn-check" name="preview-format" id="preview-a4" value="A4" />
                    <label class="btn sp-btn-secondary" for="preview-a4">A4</label>
                </div>
            </div>
            <div class="sp-preview-stage">
                <iframe id="receipt-preview" title="@L["Preview"]" class="sp-receipt-preview"
                        data-url-80="@Url.Action("Sample80", "Receipts")"
                        data-url-a4="@Url.Action("SampleA4", "Receipts")"></iframe>
            </div>
        </div>
    </div>
</section>
