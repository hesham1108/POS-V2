@model SettingsPageViewModel
<section class="sp-settings-section">
    <h2 class="sp-settings-section__title">@L["Appearance"]</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Form.NameEn" class="form-label"></label>
            <input asp-for="Form.NameEn" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Form.NameAr" class="form-label"></label>
            <input asp-for="Form.NameAr" class="form-control" dir="rtl" />
        </div>
        <div class="col-12">
            <label class="form-label d-block">@L["Theme"]</label>
            @{
                var theme = string.Equals(Model.Form.UiTheme, "dark", StringComparison.OrdinalIgnoreCase) ? "dark" : "light";
            }
            <div class="sp-theme-cards" role="radiogroup" aria-label="@L["Theme"]">
                <label class="sp-theme-card sp-theme-card--light">
                    <input type="radio" name="Form.UiTheme" value="light" checked="@(theme == "light")" data-theme-choice />
                    <span class="sp-theme-card__preview" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="sp-theme-card__name">@L["Light"]</span>
                </label>
                <label class="sp-theme-card sp-theme-card--dark">
                    <input type="radio" name="Form.UiTheme" value="dark" checked="@(theme == "dark")" data-theme-choice />
                    <span class="sp-theme-card__preview" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="sp-theme-card__name">@L["Dark"]</span>
                </label>
            </div>
        </div>
        <div class="col-md-6">
            <label asp-for="Form.UiPrimaryColor" class="form-label"></label>
            <div class="sp-color-field" data-color-field data-fallback="#1559d6">
                <div class="sp-swatches" role="group" aria-label="@L["Main color"]">
                    @foreach (var c in new[] { "#1559d6", "#0f6751", "#7c3aed", "#db2777", "#dc2626", "#ea580c", "#ca8a04", "#0891b2", "#475569" })
                    {
                        <button type="button" class="sp-swatch" style="--c:@c" data-swatch="@c" aria-label="@L["Pick a color"]"></button>
                    }
                </div>
                <div class="sp-color-input">
                    <input type="color" class="sp-color-picker" data-color-picker aria-label="@L["Pick a color"]" />
                    <input asp-for="Form.UiPrimaryColor" class="form-control" placeholder="#1559d6" data-color-text maxlength="7" />
                    <button type="button" class="btn sp-btn-secondary" data-color-reset>@L["Default"]</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label asp-for="Form.UiSidebarColor" class="form-label"></label>
            <div class="sp-color-field" data-color-field data-fallback="#ffffff" data-target="sidebar">
                <div class="sp-swatches" role="group" aria-label="@L["Sidebar color"]">
                    @foreach (var c in new[] { "#ffffff", "#f1f5f9", "#1a1d26", "#0f172a", "#14213d", "#0f3d2e", "#3b0764", "#450a0a", "#1f2937" })
                    {
                        <button type="button" class="sp-swatch" style="--c:@c" data-swatch="@c" aria-label="@L["Pick a color"]"></button>
                    }
                </div>
                <div class="sp-color-input">
                    <input type="color" class="sp-color-picker" data-color-picker aria-label="@L["Pick a color"]" />
                    <input asp-for="Form.UiSidebarColor" class="form-control" placeholder="#1a1d26" data-color-text maxlength="7" />
                    <button type="button" class="btn sp-btn-secondary" data-color-reset>@L["Default"]</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">@L["UI logo"]</label>
            <input type="file" name="uiLogoFile" class="form-control" accept=".png,.jpg,.jpeg,.webp" />
            <input type="hidden" asp-for="Form.UiLogoRelativePath" />
            @{
                var uiLogo = !string.IsNullOrWhiteSpace(Model.Form.UiLogoRelativePath)
                    ? Model.Form.UiLogoRelativePath
                    : Model.Form.LogoRelativePath;
            }
            @if (!string.IsNullOrWhiteSpace(uiLogo))
            {
                <div class="mt-2"><img src="~/@uiLogo" alt="logo" style="max-height:64px" /></div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">@L["Favicon"]</label>
            <input type="file" name="faviconFile" class="form-control" accept=".png,.jpg,.jpeg,.webp,.ico" />
            <input type="hidden" asp-for="Form.FaviconRelativePath" />
            @if (!string.IsNullOrWhiteSpace(Model.Form.FaviconRelativePath))
            {
                <div class="mt-2"><img src="~/@Model.Form.FaviconRelativePath" alt="favicon" style="max-height:32px" /></div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">@L["A4 logo"]</label>
            <input type="file" name="logoFile" class="form-control" accept=".png,.jpg,.jpeg,.webp" />
            <input type="hidden" asp-for="Form.LogoRelativePath" />
            @if (!string.IsNullOrWhiteSpace(Model.Form.LogoRelativePath))
            {
                <div class="mt-2"><img src="~/@Model.Form.LogoRelativePath" alt="a4 logo" style="max-height:64px" /></div>
            }
        </div>
    </div>
</section>
