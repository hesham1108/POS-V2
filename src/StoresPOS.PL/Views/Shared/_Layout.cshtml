@inject Microsoft.Extensions.Options.IOptionsMonitor<StoresPOS.BLL.Models.StoreSettings> StoreOptions
@{
    var store = StoreOptions.CurrentValue;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsCtrl(params string[] names) =>
        names.Any(n => string.Equals(controller, n, StringComparison.OrdinalIgnoreCase));
    string NavClass(bool active) => active ? "app-sidebar__link is-active" : "app-sidebar__link";
    bool Can(string permission) => User.HasClaim(AppPermissions.ClaimType, permission);
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var sectionLabel = ViewData["Section"] as string
        ?? ViewData["Breadcrumb"] as string
        ?? "StoresPOS";
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@(store.IsDarkTheme ? "dark" : "light")" data-leave-text="@L["You have unsaved changes. Leave this page?"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(isRtl ? store.NameAr : store.NameEn)</title>
    @* "~/" is only resolved in literal attributes, so build the URL explicitly. *@
    <link rel="stylesheet" href="@Url.Content(isRtl ? "~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <partial name="_ThemeHead" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        @* Sidebar order matches Hesham mockups *@
        <aside class="app-sidebar" id="app-sidebar" aria-label="@L["Main navigation"]">
            <button type="button" class="app-sidebar__close" data-sidebar-toggle aria-label="@L["Close menu"]">&times;</button>
            <a class="app-sidebar__brand" asp-controller="Home" asp-action="Index">
                @{
                    var brandLogo = store.EffectiveUiLogoPath;
                }
                @if (!string.IsNullOrWhiteSpace(brandLogo))
                {
                    <img class="sp-brand-mark sp-brand-mark--img" src="~/@brandLogo" alt="" />
                }
                else
                {
                    <span class="sp-brand-mark" aria-hidden="true">SP</span>
                }
                <span>
                    <strong>@(isRtl ? store.NameAr : store.NameEn)</strong>
                    <span>StoresPOS</span>
                </span>
            </a>

            <nav class="app-sidebar__nav">
                @* Grouped with icons. Visibility follows permissions (plan.md roles matrix). *@
                @{
                    var denied = L["No access"].Value;
                }
                @if (Can(AppPermissions.DashboardView))
                {
                    <a class="@NavClass(IsCtrl("Home"))" asp-controller="Home" asp-action="Index"><partial name="_PosIcon" model='"home"' />@L["Dashboard"]</a>
                }
                @if (Can(AppPermissions.PosUse))
                {
                    <a class="@NavClass(IsCtrl("Pos"))" asp-controller="Shifts" asp-action="Gate"><partial name="_PosIcon" model='"cart"' />@L["POS"]</a>
                }
                @if (Can(AppPermissions.ShiftsOpenResume))
                {
                    <a class="@NavClass(IsCtrl("Shifts"))" asp-controller="Shifts" asp-action="Current"><partial name="_PosIcon" model='"clock"' />@L["Shifts"]</a>
                }

                <p class="app-sidebar__section">@L["Sales"]</p>
                @if (Can(AppPermissions.ReportsView))
                {
                    <a class="@NavClass(IsCtrl("Sales"))" asp-controller="Sales" asp-action="Index"><partial name="_PosIcon" model='"receipt"' />@L["Sales invoices"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"receipt"' />@L["Sales invoices"]</span>
                }
                @if (Can(AppPermissions.ReturnsCreate) || Can(AppPermissions.ReportsView))
                {
                    <a class="@NavClass(IsCtrl("Returns"))" asp-controller="Returns" asp-action="Index"><partial name="_PosIcon" model='"undo"' />@L["Returns"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"undo"' />@L["Returns"]</span>
                }
                @if (Can(AppPermissions.CashOutsCreate) || Can(AppPermissions.ReportsView))
                {
                    <a class="@NavClass(IsCtrl("CashOuts"))" asp-controller="CashOuts" asp-action="Index"><partial name="_PosIcon" model='"coins"' />@L["Cash-outs"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"coins"' />@L["Cash-outs"]</span>
                }
                @if (Can(AppPermissions.ReportsView))
                {
                    <a class="@NavClass(IsCtrl("Customers"))" asp-controller="Customers" asp-action="Index"><partial name="_PosIcon" model='"users"' />@L["Customers"]</a>
                    <a class="@NavClass(IsCtrl("Reports"))" asp-controller="Reports" asp-action="Sales"><partial name="_PosIcon" model='"chart"' />@L["Reports"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"users"' />@L["Customers"]</span>
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"chart"' />@L["Reports"]</span>
                }

                <p class="app-sidebar__section">@L["Catalog"]</p>
                @if (Can(AppPermissions.CatalogManage))
                {
                    <a class="@NavClass(IsCtrl("Products", "Categories", "Inventory"))"
                       asp-controller="Products" asp-action="Index"><partial name="_PosIcon" model='"box"' />@L["Products and categories"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"box"' />@L["Products and categories"]</span>
                }
                @if (Can(AppPermissions.PurchasesManage))
                {
                    <a class="@NavClass(IsCtrl("Purchases"))"
                       asp-controller="Purchases" asp-action="Index"><partial name="_PosIcon" model='"file"' />@L["Purchase invoices"]</a>
                    <a class="@NavClass(IsCtrl("Suppliers"))"
                       asp-controller="Suppliers" asp-action="Index"><partial name="_PosIcon" model='"truck"' />@L["Suppliers"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"file"' />@L["Purchase invoices"]</span>
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"truck"' />@L["Suppliers"]</span>
                }
                @if (Can(AppPermissions.WarehousesView))
                {
                    <a class="@NavClass(IsCtrl("Warehouses"))" asp-controller="Warehouses" asp-action="Index"><partial name="_PosIcon" model='"warehouse"' />@L["Warehouses"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"warehouse"' />@L["Warehouses"]</span>
                }

                <p class="app-sidebar__section">@L["Finance"]</p>
                @if (Can(AppPermissions.TreasuriesView))
                {
                    <a class="@NavClass(IsCtrl("Treasuries"))" asp-controller="Treasuries" asp-action="Index"><partial name="_PosIcon" model='"bank"' />@L["Treasuries"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"bank"' />@L["Treasuries"]</span>
                }
                @if (Can(AppPermissions.ChequesView))
                {
                    <a class="@NavClass(IsCtrl("Cheques"))" asp-controller="Cheques" asp-action="Index"><partial name="_PosIcon" model='"cheque"' />@L["Cheques"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"cheque"' />@L["Cheques"]</span>
                }
                @if (Can(AppPermissions.PaymentMethodsManage))
                {
                    <a class="@NavClass(IsCtrl("PaymentMethods"))" asp-controller="PaymentMethods" asp-action="Index"><partial name="_PosIcon" model='"card"' />@L["Payment methods"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"card"' />@L["Payment methods"]</span>
                }

                <p class="app-sidebar__section">@L["Administration"]</p>
                @if (Can(AppPermissions.UsersManage))
                {
                    <a class="@NavClass(IsCtrl("Users"))" asp-controller="Users" asp-action="Index"><partial name="_PosIcon" model='"shield"' />@L["Users and roles"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"shield"' />@L["Users and roles"]</span>
                }
                @if (Can(AppPermissions.SettingsManage))
                {
                    <a class="@NavClass(IsCtrl("Settings"))" asp-controller="Settings" asp-action="Index"><partial name="_PosIcon" model='"settings"' />@L["Settings"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied"><partial name="_PosIcon" model='"settings"' />@L["Settings"]</span>
                }
            </nav>

            <div class="app-sidebar__footer">
                <div class="app-sidebar__user">
                    <span class="sp-badge app-sidebar__user-badge">
                        <span class="sp-badge-dot"></span>
                        @User.Identity?.Name
                    </span>
                </div>
                <form asp-controller="Culture" asp-action="Set" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ui" value="@(isRtl ? "en" : "ar")" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="app-sidebar__logout">@(isRtl ? "English" : "العربية")</button>
                </form>
                <a class="app-sidebar__logout d-block text-decoration-none mb-2" asp-controller="Account" asp-action="ChangePassword">@L["Change password"]</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-sidebar__logout">@L["Logout"]</button>
                </form>
            </div>
        </aside>

        <div class="app-backdrop" data-sidebar-toggle></div>
        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar__lead">
                    <button type="button" class="app-menu-btn" data-sidebar-toggle aria-controls="app-sidebar" aria-label="@L["Open menu"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    </button>
                    @{
                        var pageTitle = ViewData["Title"] as string;
                        var showSection = !string.IsNullOrWhiteSpace(sectionLabel)
                            && !string.Equals(sectionLabel, pageTitle, StringComparison.OrdinalIgnoreCase);
                    }
                    @if (ViewData["Breadcrumb"] is string crumb)
                    {
                        <div class="app-breadcrumb">@crumb</div>
                    }
                    else if (showSection)
                    {
                        <p class="app-topbar__section">@sectionLabel</p>
                    }
                </div>
                <div class="app-topbar__actions">
                    @await RenderSectionAsync("PageActions", required: false)
                </div>
            </header>
            <main class="app-content" role="main">
                @RenderBody()
            </main>
            <footer class="app-footer">
                @L["StoresPOS · Local offline installation"]
            </footer>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/print-frame.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
