@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsCtrl(params string[] names) =>
        names.Any(n => string.Equals(controller, n, StringComparison.OrdinalIgnoreCase));
    string NavClass(bool active) => active ? "app-sidebar__link is-active" : "app-sidebar__link";
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var sectionLabel = ViewData["Section"] as string
        ?? ViewData["Breadcrumb"] as string
        ?? "StoresPOS";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoresPOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        @* Sidebar order matches Hesham mockups *@
        <aside class="app-sidebar" aria-label="Main navigation">
            <a class="app-sidebar__brand" asp-controller="Home" asp-action="Index">
                <span class="sp-brand-mark" aria-hidden="true">SP</span>
                <span>
                    <strong>[STORE NAME]</strong>
                    <span>StoresPOS</span>
                </span>
            </a>

            <nav class="app-sidebar__nav">
                @* Order: page-composition.md §24.3. POS/Shifts/Cash-outs open for all roles once Phase 6+ lands. *@
                <a class="@NavClass(IsCtrl("Home"))" asp-controller="Home" asp-action="Index">Dashboard</a>

                <span class="app-sidebar__link is-disabled" title="Coming in Phase 7 (opens the shift gate)">POS</span>
                <span class="app-sidebar__link is-disabled" title="Coming in Phase 6">Shifts</span>

                <span class="app-sidebar__link is-disabled" title="@(canManage ? "Coming in Phase 7" : "No access")">Sales invoices</span>
                <span class="app-sidebar__link is-disabled" title="Coming in Phase 9">Returns</span>
                <span class="app-sidebar__link is-disabled" title="Coming in Phase 9">Cash-outs</span>

                @if (canManage)
                {
                    <a class="@NavClass(IsCtrl("Products", "Categories", "Inventory"))"
                       asp-controller="Products" asp-action="Index">Products and categories</a>

                    <a class="@NavClass(IsCtrl("Purchases"))"
                       asp-controller="Purchases" asp-action="Index">Purchase invoices</a>

                    <a class="@NavClass(IsCtrl("Suppliers"))"
                       asp-controller="Suppliers" asp-action="Index">Suppliers</a>

                    <span class="app-sidebar__link is-disabled" title="Coming in Phase 10">Customers</span>
                    <span class="app-sidebar__link is-disabled" title="Coming in Phase 10">Reports</span>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="No access">Products and categories</span>
                    <span class="app-sidebar__link is-disabled" title="No access">Purchase invoices</span>
                    <span class="app-sidebar__link is-disabled" title="No access">Suppliers</span>
                    <span class="app-sidebar__link is-disabled" title="No access">Customers</span>
                    <span class="app-sidebar__link is-disabled" title="No access">Reports</span>
                }

                @if (User.IsInRole(AppRoles.Admin))
                {
                    <span class="app-sidebar__link is-disabled" title="Coming in a later phase">Users and roles</span>
                    <span class="app-sidebar__link is-disabled" title="Coming in Phase 11">Settings</span>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="No access">Users and roles</span>
                    <span class="app-sidebar__link is-disabled" title="No access">Settings</span>
                }
            </nav>

            <div class="app-sidebar__footer">
                <div class="app-sidebar__user">
                    <span class="sp-badge app-sidebar__user-badge">
                        <span class="sp-badge-dot"></span>
                        @User.Identity?.Name
                    </span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-sidebar__logout">Logout</button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar__lead">
                    @{
                        var pageTitle = ViewData["Title"] as string;
                        var showSection = !string.IsNullOrWhiteSpace(sectionLabel)
                            && !string.Equals(sectionLabel, pageTitle, StringComparison.OrdinalIgnoreCase);
                    }
                    @if (ViewData["Breadcrumb"] is string crumb)
                    {
                        <div class="app-breadcrumb">@crumb</div>
                    }
                    else if (showSection)
                    {
                        <p class="app-topbar__section">@sectionLabel</p>
                    }
                </div>
                <div class="app-topbar__actions">
                    @await RenderSectionAsync("PageActions", required: false)
                </div>
            </header>
            <main class="app-content" role="main">
                @RenderBody()
            </main>
            <footer class="app-footer">
                StoresPOS · Local offline installation
            </footer>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
