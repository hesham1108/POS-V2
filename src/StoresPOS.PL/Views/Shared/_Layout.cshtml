@inject Microsoft.Extensions.Options.IOptions<StoresPOS.BLL.Models.StoreSettings> StoreOptions
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsCtrl(params string[] names) =>
        names.Any(n => string.Equals(controller, n, StringComparison.OrdinalIgnoreCase));
    string NavClass(bool active) => active ? "app-sidebar__link is-active" : "app-sidebar__link";
    bool Can(string permission) => User.HasClaim(AppPermissions.ClaimType, permission);
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var sectionLabel = ViewData["Section"] as string
        ?? ViewData["Breadcrumb"] as string
        ?? "StoresPOS";
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoresPOS</title>
    <link rel="stylesheet" href="@(isRtl ? "~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        @* Sidebar order matches Hesham mockups *@
        <aside class="app-sidebar" aria-label="Main navigation">
            <a class="app-sidebar__brand" asp-controller="Home" asp-action="Index">
                <span class="sp-brand-mark" aria-hidden="true">SP</span>
                <span>
                    <strong>@(isRtl ? StoreOptions.Value.NameAr : StoreOptions.Value.NameEn)</strong>
                    <span>StoresPOS</span>
                </span>
            </a>

            <nav class="app-sidebar__nav">
                @* Order: docs/page-composition.md §24.3. Visibility follows permissions (plan.md roles matrix). *@
                @{
                    var soon = L["Coming in a later phase"].Value;
                    var denied = L["No access"].Value;
                }
                @if (Can(AppPermissions.DashboardView))
                {
                    <a class="@NavClass(IsCtrl("Home"))" asp-controller="Home" asp-action="Index">@L["Dashboard"]</a>
                }

                @if (Can(AppPermissions.PosUse))
                {
                    <a class="@NavClass(IsCtrl("Pos"))" asp-controller="Shifts" asp-action="Gate">@L["POS"]</a>
                }

                @if (Can(AppPermissions.ShiftsOpenResume))
                {
                    <a class="@NavClass(IsCtrl("Shifts"))" asp-controller="Shifts" asp-action="Current">@L["Shifts"]</a>
                }

                @if (Can(AppPermissions.ReportsView))
                {
                    <a class="@NavClass(IsCtrl("Sales"))" asp-controller="Sales" asp-action="Index">@L["Sales invoices"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied">@L["Sales invoices"]</span>
                }
                <span class="app-sidebar__link is-disabled" title="@soon">@L["Returns"]</span>
                <span class="app-sidebar__link is-disabled" title="@soon">@L["Cash-outs"]</span>

                @if (Can(AppPermissions.CatalogManage))
                {
                    <a class="@NavClass(IsCtrl("Products", "Categories", "Inventory"))"
                       asp-controller="Products" asp-action="Index">@L["Products and categories"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied">@L["Products and categories"]</span>
                }

                @if (Can(AppPermissions.PurchasesManage))
                {
                    <a class="@NavClass(IsCtrl("Purchases"))"
                       asp-controller="Purchases" asp-action="Index">@L["Purchase invoices"]</a>
                    <a class="@NavClass(IsCtrl("Suppliers"))"
                       asp-controller="Suppliers" asp-action="Index">@L["Suppliers"]</a>
                }
                else
                {
                    <span class="app-sidebar__link is-disabled" title="@denied">@L["Purchase invoices"]</span>
                    <span class="app-sidebar__link is-disabled" title="@denied">@L["Suppliers"]</span>
                }

                <span class="app-sidebar__link is-disabled" title="@(Can(AppPermissions.ReportsView) ? soon : denied)">@L["Customers"]</span>
                <span class="app-sidebar__link is-disabled" title="@(Can(AppPermissions.ReportsView) ? soon : denied)">@L["Reports"]</span>
                <span class="app-sidebar__link is-disabled" title="@(Can(AppPermissions.UsersManage) ? soon : denied)">@L["Users and roles"]</span>
                <span class="app-sidebar__link is-disabled" title="@(Can(AppPermissions.SettingsManage) ? soon : denied)">@L["Settings"]</span>
            </nav>

            <div class="app-sidebar__footer">
                <div class="app-sidebar__user">
                    <span class="sp-badge app-sidebar__user-badge">
                        <span class="sp-badge-dot"></span>
                        @User.Identity?.Name
                    </span>
                </div>
                <form asp-controller="Culture" asp-action="Set" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ui" value="@(isRtl ? "en" : "ar")" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="app-sidebar__logout">@(isRtl ? "English" : "العربية")</button>
                </form>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-sidebar__logout">@L["Logout"]</button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar__lead">
                    @{
                        var pageTitle = ViewData["Title"] as string;
                        var showSection = !string.IsNullOrWhiteSpace(sectionLabel)
                            && !string.Equals(sectionLabel, pageTitle, StringComparison.OrdinalIgnoreCase);
                    }
                    @if (ViewData["Breadcrumb"] is string crumb)
                    {
                        <div class="app-breadcrumb">@crumb</div>
                    }
                    else if (showSection)
                    {
                        <p class="app-topbar__section">@sectionLabel</p>
                    }
                </div>
                <div class="app-topbar__actions">
                    @await RenderSectionAsync("PageActions", required: false)
                </div>
            </header>
            <main class="app-content" role="main">
                @RenderBody()
            </main>
            <footer class="app-footer">
                @L["StoresPOS · Local offline installation"]
            </footer>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @RenderBody()
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/print-frame.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
