@{
    var fmt = (ReceiptFormat)ViewData["ReceiptFormat"]!;
    fmt.ApplyCulture();
    var autoPrint = ViewData["AutoPrint"] is true;
    // Phase 24: orientation, margin and font size come from the document's template.
    var tpl = ViewData["Template"] as StoresPOS.BLL.Models.PrintTemplate;
    var orientation = tpl is null || tpl.Landscape ? "landscape" : "portrait";
    var margin = tpl?.MarginMm ?? 10;
    var scale = (tpl?.FontScale ?? 1m).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="@fmt.Language" dir="@(fmt.IsRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/a4-invoice.css" asp-append-version="true" />
    <style>
        @@page { size: A4 @orientation; margin: @(margin)mm; }
        .a4-body { font-size: @(scale)em; }
    </style>
</head>
<body class="a4-body">
    @RenderBody()
    @if (autoPrint)
    {
        <script>
            function storesAutoPrint() {
                try { window.focus(); window.print(); } catch (e) { /* ignore */ }
            }
            window.addEventListener("load", function () {
                setTimeout(storesAutoPrint, 100);
                setTimeout(storesAutoPrint, 500);
            });
        </script>
    }
</body>
</html>
