@model PaymentMethod
@inject IPaymentMethodService PaymentMethods
@{
    var def = await PaymentMethods.GetAsync((byte)Model);
    var isCash = def?.IsCash == true || Model == PaymentMethod.Cash;
    var css = isCash ? "sp-status-ok" : "sp-status-info";
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var text = def is null
        ? Model switch
        {
            PaymentMethod.Cash => L["Cash"].Value,
            PaymentMethod.Card => L["Visa / Card"].Value,
            PaymentMethod.InstaPay => L["InstaPay"].Value,
            PaymentMethod.Cheque => L["Cheque"].Value,
            _ => L["Vodafone Cash"].Value
        }
        : def.NameFor(lang);
}
<span class="sp-status @css">@text</span>
