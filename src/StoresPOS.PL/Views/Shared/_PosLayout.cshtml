@{
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    bool Can(string permission) => User.HasClaim(AppPermissions.ClaimType, permission);
    var shiftId = ViewData["ShiftId"];
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoresPOS</title>
    <link rel="stylesheet" href="@(isRtl ? "~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
</head>
<body class="pos-body">
    @* Full-screen till: no sidebar (docs/page-composition.md §7). *@
    <header class="pos-header">
        <div class="pos-header__brand">
            <span class="sp-brand-mark" aria-hidden="true">SP</span>
            <strong>[STORE NAME]</strong>
            <span class="sp-status sp-status-ok">@L["Shift open"] · #@shiftId</span>
        </div>
        <div class="pos-header__actions">
            <span class="pos-header__cashier">@L["Cashier"]: <strong>@ViewData["CashierName"]</strong></span>
            <a class="btn btn-sm sp-btn-secondary" asp-controller="Shifts" asp-action="Current">@L["Shift"]</a>
            <span class="btn btn-sm sp-btn-secondary disabled" title="@L["Coming in a later phase"]" aria-disabled="true">@L["Cash-out"]</span>
            @if (Can(AppPermissions.ShiftsClose))
            {
                <a class="btn btn-sm sp-btn-secondary" asp-controller="Shifts" asp-action="Close">@L["Close shift"]</a>
            }
            @if (Can(AppPermissions.DashboardView))
            {
                <a class="btn btn-sm sp-btn-secondary" asp-controller="Home" asp-action="Index">@L["Dashboard"]</a>
            }
            <form asp-controller="Culture" asp-action="Set" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ui" value="@(isRtl ? "en" : "ar")" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-sm sp-btn-secondary">@(isRtl ? "English" : "العربية")</button>
            </form>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm sp-btn-secondary">@L["Logout"]</button>
            </form>
        </div>
    </header>

    <main class="pos-main" role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
