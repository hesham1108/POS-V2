@inject Microsoft.Extensions.Options.IOptionsMonitor<StoresPOS.BLL.Models.StoreSettings> StoreOptions
@{
    var store = StoreOptions.CurrentValue;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    bool Can(string permission) => User.HasClaim(AppPermissions.ClaimType, permission);
    var shiftId = ViewData["ShiftId"];
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@(store.IsDarkTheme ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(isRtl ? store.NameAr : store.NameEn)</title>
    @* "~/" is only resolved in literal attributes, so build the URL explicitly. *@
    <link rel="stylesheet" href="@Url.Content(isRtl ? "~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
    <partial name="_ThemeHead" />
</head>
<body class="pos-body">
    <div class="pos-shell">
        @* Narrow icon rail (right side in Arabic). Links follow the same permissions as the main sidebar. *@
        <div class="app-backdrop" data-sidebar-toggle></div>
        <nav class="pos-rail" id="pos-rail" aria-label="@L["POS"]">
            <button type="button" class="app-sidebar__close" data-sidebar-toggle aria-label="@L["Close menu"]">&times;</button>
            <a class="pos-rail__brand" asp-controller="Pos" asp-action="Index">
                @{
                    var posLogo = store.EffectiveUiLogoPath;
                }
                @if (!string.IsNullOrWhiteSpace(posLogo))
                {
                    <img class="pos-rail__logo pos-rail__logo--img" src="~/@posLogo" alt="" />
                }
                else
                {
                    <span class="pos-rail__logo" aria-hidden="true">SP</span>
                }
                <span class="pos-rail__name">StoresPOS</span>
            </a>

            @if (Can(AppPermissions.DashboardView))
            {
                <a class="pos-rail__link" asp-controller="Home" asp-action="Index">
                    <partial name="_PosIcon" model='"home"' /><span>@L["Dashboard"]</span>
                </a>
            }
            <a class="pos-rail__link is-active" asp-controller="Pos" asp-action="Index" aria-current="page">
                <partial name="_PosIcon" model='"cart"' /><span>@L["POS"]</span>
            </a>
            @if (Can(AppPermissions.ReturnsCreate) || Can(AppPermissions.ReportsView))
            {
                <a class="pos-rail__link" asp-controller="Returns" asp-action="Index">
                    <partial name="_PosIcon" model='"undo"' /><span>@L["Returns"]</span>
                </a>
            }
            @if (Can(AppPermissions.CashOutsCreate) || Can(AppPermissions.ReportsView))
            {
                <a class="pos-rail__link" asp-controller="CashOuts" asp-action="Index">
                    <partial name="_PosIcon" model='"coins"' /><span>@L["Cash-outs"]</span>
                </a>
            }
            @if (Can(AppPermissions.ShiftsOpenResume))
            {
                <a class="pos-rail__link" asp-controller="Shifts" asp-action="Current">
                    <partial name="_PosIcon" model='"clock"' /><span>@L["Shifts"]</span>
                </a>
            }
            @if (Can(AppPermissions.CatalogManage))
            {
                <a class="pos-rail__link" asp-controller="Products" asp-action="Index">
                    <partial name="_PosIcon" model='"box"' /><span>@L["Items"]</span>
                </a>
                <a class="pos-rail__link" asp-controller="Inventory" asp-action="Index">
                    <partial name="_PosIcon" model='"layers"' /><span>@L["Inventory"]</span>
                </a>
            }
            @if (Can(AppPermissions.ReportsView))
            {
                <a class="pos-rail__link" asp-controller="Customers" asp-action="Index">
                    <partial name="_PosIcon" model='"users"' /><span>@L["Customers"]</span>
                </a>
                <a class="pos-rail__link" asp-controller="Reports" asp-action="Sales">
                    <partial name="_PosIcon" model='"chart"' /><span>@L["Reports"]</span>
                </a>
            }
            @if (Can(AppPermissions.SettingsManage))
            {
                <a class="pos-rail__link" asp-controller="Settings" asp-action="Index">
                    <partial name="_PosIcon" model='"settings"' /><span>@L["Settings"]</span>
                </a>
            }
        </nav>

        <div class="pos-stage">
            <header class="pos-header">
                <button type="button" class="app-menu-btn pos-menu-btn" data-sidebar-toggle aria-controls="pos-rail" aria-label="@L["Open menu"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <h1 class="pos-header__title">@L["POS"]</h1>
                <span class="pos-shift-badge"><span class="pos-shift-badge__dot" aria-hidden="true"></span>@L["Shift open"] <span class="num">#@shiftId</span></span>
                <span class="pos-header__sep" aria-hidden="true"></span>
                <span class="pos-header__cashier" title="@L["Cashier"]">
                    <partial name="_PosIcon" model='"user"' />
                    <strong>@ViewData["CashierName"]</strong>
                </span>

                <div class="pos-header__end">
                    <span class="pos-header__clock">
                        <partial name="_PosIcon" model='"clock"' />
                        <span id="pos-clock" class="num" data-am="@(isRtl ? "ص" : "AM")" data-pm="@(isRtl ? "م" : "PM")"></span>
                    </span>

                    @{
                        string? reprintUrl = null;
                        if (ViewData["LastInvoiceId"] is int lastId)
                        {
                            reprintUrl = store.PrefersA4Receipt
                                ? Url.Action("SaleA4", "Receipts", new { id = lastId })
                                : Url.Action("Sale", "Receipts", new { id = lastId });
                        }
                    }
                    <div class="dropdown">
                        <button type="button" class="pos-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["More"]">
                            <partial name="_PosIcon" model='"more"' />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end pos-menu">
                            <li>
                                <button type="button" id="pos-reprint" class="dropdown-item"
                                        data-print-url="@reprintUrl"
                                        data-invoice-id="@(ViewData["LastInvoiceId"] is int lid ? lid.ToString() : null)"
                                        data-print-format="@(store.PrefersA4Receipt ? "A4" : "80mm")"
                                        @(reprintUrl is null ? "disabled" : null)>
                                    <partial name="_PosIcon" model='"printer"' />@L["Reprint last"]
                                </button>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Shifts" asp-action="Current">
                                    <partial name="_PosIcon" model='"clock"' />@L["Shift"]
                                </a>
                            </li>
                            @if (Can(AppPermissions.ShiftsClose))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Shifts" asp-action="Close">
                                        <partial name="_PosIcon" model='"lock"' />@L["Close shift"]
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Culture" asp-action="Set" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ui" value="@(isRtl ? "en" : "ar")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item">
                                        <partial name="_PosIcon" model='"globe"' />@(isRtl ? "English" : "العربية")
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <partial name="_PosIcon" model='"logout"' />@L["Logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="pos-main" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/print-frame.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @if (Can(AppPermissions.CashOutsCreate))
    {
        <partial name="_CashOutModal" />
        <script src="~/js/cashout.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
