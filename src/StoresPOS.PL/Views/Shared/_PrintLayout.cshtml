@{
    // Printed documents use the store language from settings, not the cashier's UI language.
    var fmt = (ReceiptFormat)ViewData["ReceiptFormat"]!;
    fmt.ApplyCulture();
    var autoPrint = ViewData["AutoPrint"] is true;
    var paper = fmt.Settings.PaperWidthMm;
    // Phase 24: font size from the document's template (falls back to the store-wide receipt scale).
    var tpl = ViewData["Template"] as StoresPOS.BLL.Models.PrintTemplate;
    var scale = (tpl?.FontScale ?? fmt.Settings.ReceiptFontScale).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="@fmt.Language" dir="@(fmt.IsRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
    <style>
        @@page { size: @(paper)mm auto; margin: 0; }
        :root { --paper: @(paper)mm; }
        .receipt-body { font-size: @(scale)em; }
    </style>
</head>
<body class="receipt-body">
    @RenderBody()
    @if (autoPrint)
    {
        <script>
            // Parent print-frame.js also calls print(); this covers direct opens and kiosk mode.
            function storesAutoPrint() {
                try { window.focus(); window.print(); } catch (e) { /* ignore */ }
            }
            window.addEventListener("load", function () {
                setTimeout(storesAutoPrint, 100);
                setTimeout(storesAutoPrint, 500);
            });
        </script>
    }
</body>
</html>
