@model InventoryIndexViewModel
@{
    ViewData["Section"] = L["Products and categories"].Value;
    ViewData["Title"] = L["Inventory"].Value;
    ViewData["Subtitle"] = Model.LowStockCount > 0
        ? $"Balances · {Model.LowStockCount} low-stock"
        : L["Balances · no low-stock alerts"].Value;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Movements">@L["Movements"]</a>
    <a class="btn sp-btn-primary" asp-action="Adjust">@L["Adjust stock"]</a>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">@L["Search"]</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="@L["Name or barcode"]" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="categoryId">@L["Category"]</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">@L["All"]</option>
                @foreach (var opt in Model.CategoryOptions)
                {
                    if (Model.CategoryId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="warehouseId">@L["Warehouse"]</label>
            <select class="form-select" id="warehouseId" name="warehouseId">
                <option value="">@L["All (total)"]</option>
                @foreach (var w in Model.WarehouseOptions)
                {
                    if (Model.WarehouseId == w.Id)
                    {
                        <option value="@w.Id" selected>@Ui.Name(w.NameEn, w.NameAr)</option>
                    }
                    else
                    {
                        <option value="@w.Id">@Ui.Name(w.NameEn, w.NameAr)</option>
                    }
                }
            </select>
        </div>
        <label class="sp-filter-row__check form-check" for="lowStockOnly">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly"
                   @(Model.LowStockOnly ? "checked" : null) />
            <span class="form-check-label">@L["Low stock only"]</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table sp-table">
            <thead>
                <tr>
                    <th>@L["Product"]</th>
                    <th>@L["Category"]</th>
                    <th>@L["Barcode"]</th>
                    <th class="col-num">@L["On hand"]</th>
                    <th class="col-num">@L["Threshold"]</th>
                    <th>@L["Status"]</th>
                    <th class="col-num">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Balances.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='("No stock rows", "Try clearing filters or add products to the catalog.")' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Balances)
                {
                    <tr class="@(item.IsLowStock ? "table-warning" : null)">
                        <td>
                            <div class="fw-semibold">@Ui.Name(item.NameEn, item.NameAr)</div>
                            <div class="small text-muted" lang="@(Ui.IsArabic ? "en" : "ar")" dir="@(Ui.IsArabic ? "ltr" : "rtl")">@(Ui.IsArabic ? item.NameEn : item.NameAr)</div>
                        </td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="font-monospace">@(item.Barcode ?? "—")</td>
                        <td class="col-num font-monospace fw-semibold">
                            @item.StockQuantity.ToString("0.###") <span class="text-muted">@item.Unit</span>
                        </td>
                        <td class="col-num font-monospace">@item.LowStockThreshold.ToString("0.###")</td>
                        <td>
                            @if (item.IsLowStock)
                            {
                                <span class="sp-status sp-status-warn">@L["Low"]</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-ok">@L["OK"]</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Movements" asp-route-productId="@item.ProductId">@L["History"]</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Adjust" asp-route-productId="@item.ProductId">@L["Adjust"]</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
