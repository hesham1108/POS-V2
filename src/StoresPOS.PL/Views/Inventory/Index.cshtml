@model InventoryIndexViewModel
@{
    ViewData["Section"] = "Products and categories";
    ViewData["Title"] = "Inventory";
    ViewData["Subtitle"] = Model.LowStockCount > 0
        ? $"Balances · {Model.LowStockCount} low-stock"
        : "Balances · no low-stock alerts";
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Movements">Movements</a>
    <a class="btn sp-btn-primary" asp-action="Adjust">Adjust stock</a>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name or barcode" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="categoryId">Category</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">All</option>
                @foreach (var opt in Model.CategoryOptions)
                {
                    if (Model.CategoryId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="warehouseId">Warehouse</label>
            <select class="form-select" id="warehouseId" name="warehouseId">
                <option value="">All (total)</option>
                @foreach (var w in Model.WarehouseOptions)
                {
                    if (Model.WarehouseId == w.Id)
                    {
                        <option value="@w.Id" selected>@w.NameEn</option>
                    }
                    else
                    {
                        <option value="@w.Id">@w.NameEn</option>
                    }
                }
            </select>
        </div>
        <label class="sp-filter-row__check form-check" for="lowStockOnly">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly"
                   @(Model.LowStockOnly ? "checked" : null) />
            <span class="form-check-label">Low stock only</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Barcode</th>
                    <th class="col-num">On hand</th>
                    <th class="col-num">Threshold</th>
                    <th>Status</th>
                    <th class="col-num">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Balances.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='("No stock rows", "Try clearing filters or add products to the catalog.")' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Balances)
                {
                    <tr class="@(item.IsLowStock ? "table-warning" : null)">
                        <td>
                            <div class="fw-semibold">@item.NameEn</div>
                            <div class="small text-muted" dir="rtl">@item.NameAr</div>
                        </td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="font-monospace">@(item.Barcode ?? "—")</td>
                        <td class="col-num font-monospace fw-semibold">
                            @item.StockQuantity.ToString("0.###") <span class="text-muted">@item.Unit</span>
                        </td>
                        <td class="col-num font-monospace">@item.LowStockThreshold.ToString("0.###")</td>
                        <td>
                            @if (item.IsLowStock)
                            {
                                <span class="sp-status sp-status-warn">Low</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-ok">OK</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Movements" asp-route-productId="@item.ProductId">History</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Adjust" asp-route-productId="@item.ProductId">Adjust</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
