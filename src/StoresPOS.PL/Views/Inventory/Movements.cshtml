@model StockMovementsIndexViewModel
@using StoresPOS.PL.Extensions
@{
    var listChips = ListUrl.Chips(Context.Request, ("productId", L["Product"].Value, v => Model.ProductOptions.FirstOrDefault(p => p.Id.ToString() == v)?.DisplayName), ("warehouseId", L["Warehouse"].Value, v => Model.WarehouseOptions.FirstOrDefault(w => w.Id.ToString() == v)?.NameAr ?? ""), ("movementType", L["Type"].Value, null));
    ViewData["Section"] = L["Products and categories"].Value;
    ViewData["Title"] = L["Stock movements"].Value;
    ViewData["Subtitle"] = L["Ledger of purchases and adjustments"].Value;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">@L["Balances"]</a>
    <a class="btn sp-btn-primary" asp-action="Adjust">@L["Adjust stock"]</a>
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<partial name="_ListToolbar" model='new ListToolbarModel { Q = null, SearchPlaceholder = "", Chips = listChips, Page = Model.Page, ShowSearch = false }' />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="productId">@L["Product"]</label>
            <select class="form-select" id="productId" name="productId">
                <option value="">@L["All"]</option>
                @foreach (var opt in Model.ProductOptions)
                {
                    if (Model.ProductId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.DisplayName</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="warehouseId">@L["Warehouse"]</label>
            <select class="form-select" id="warehouseId" name="warehouseId">
                <option value="">@L["All"]</option>
                @foreach (var w in Model.WarehouseOptions)
                {
                    if (Model.WarehouseId == w.Id)
                    {
                        <option value="@w.Id" selected>@Ui.Name(w.NameEn, w.NameAr)</option>
                    }
                    else
                    {
                        <option value="@w.Id">@Ui.Name(w.NameEn, w.NameAr)</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="movementType">@L["Type"]</label>
            <select class="form-select" id="movementType" name="movementType">
                <option value="">@L["All"]</option>
                @foreach (StockMovementType type in Enum.GetValues<StockMovementType>())
                {
                    if (Model.MovementType == type)
                    {
                        <option value="@((int)type)" selected>@L[type.ToString()]</option>
                    }
                    else
                    {
                        <option value="@((int)type)">@L[type.ToString()]</option>
                    }
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive sp-table-scroll">
        <table class="table sp-table">
            <thead>
                <tr>
                    <partial name="_SortTh" model='new SortHeader("CreatedAtUtc", L["Date"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("ProductNameEn", L["Product"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("WarehouseNameEn", L["Warehouse"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("MovementType", L["Type"].Value, Model.Page)' />
                    <partial name="_SortTh" model='new SortHeader("QuantityChange", L["Change"].Value, Model.Page, Numeric: true)' />
                    <th class="col-num">@L["Before"]</th>
                    <partial name="_SortTh" model='new SortHeader("QuantityAfter", L["After"].Value, Model.Page, Numeric: true)' />
                    <th>@L["Reference"]</th>
                    <th>@L["By"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Movements.Count == 0)
            {
                <tr>
                    <td colspan="9">
                        <partial name="_EmptyState" model='(L["No movements yet"].Value, L["Purchases and stock adjustments will appear here."].Value)' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Movements)
                {
                    <tr>
                        <td class="font-monospace small">@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div>@item.ProductName</div>
                            <div class="small text-muted">@item.Unit</div>
                        </td>
                        <td>@(item.WarehouseName ?? "—")</td>
                        <td><span class="sp-status sp-status-neutral">@L[item.MovementType.ToString()]</span></td>
                        <td class="col-num font-monospace @(item.QuantityChange < 0 ? "text-danger" : null)" style="@(item.QuantityChange >= 0 ? "color:var(--sp-primary)" : null)">
                            @(item.QuantityChange > 0 ? "+" : "")@item.QuantityChange.ToString("0.###")
                        </td>
                        <td class="col-num font-monospace">@item.QuantityBefore.ToString("0.###")</td>
                        <td class="col-num font-monospace fw-semibold">@item.QuantityAfter.ToString("0.###")</td>
                        <td>
                            <div>@(item.Reference ?? "—")</div>
                            @if (!string.IsNullOrWhiteSpace(item.Reason))
                            {
                                <div class="small text-muted">@item.Reason</div>
                            }
                        </td>
                        <td>@item.CreatedByUsername</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
        <partial name="_Pager" model="Model.Page" />
</div>
