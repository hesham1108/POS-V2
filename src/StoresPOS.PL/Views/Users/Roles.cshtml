@model RoleMatrixPageViewModel
@{
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var granted = Model.Roles.ToDictionary(r => r.RoleId, r => r.Permissions.ToHashSet());
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">@L["Back to users"]</a>
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<form asp-action="SaveRoles" method="post" class="sp-form" id="role-matrix">
    @Html.AntiForgeryToken()
    @foreach (var r in Model.Roles.Where(r => !r.IsLocked))
    {
        <input type="hidden" name="roleIds" value="@r.RoleId" />
    }

    <div class="sp-card mb-3">
        <div class="sp-perm-toolbar p-3 pb-0">
            <input type="search" class="form-control" id="matrix-search" placeholder="@L["Search permissions"]" aria-label="@L["Search permissions"]" data-no-dirty />
        </div>
        <div class="table-responsive sp-table-scroll">
            <table class="table sp-table sp-role-matrix">
                <thead>
                    <tr>
                        <th>@L["Permission"]</th>
                        @foreach (var r in Model.Roles)
                        {
                            <th class="text-center">
                                @r.RoleName
                                <small class="d-block text-muted fw-normal text-none">@string.Format(L["{0} users"].Value, r.UserCount)</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in AppPermissions.Groups)
                    {
                        <tr class="sp-role-matrix__group"><th colspan="@(Model.Roles.Count + 1)">@(isAr ? group.LabelAr : group.LabelEn)</th></tr>
                        @foreach (var perm in group.Permissions)
                        {
                            var label = AppPermissions.LabelFor(perm);
                            <tr data-matrix-row data-search="@label.LabelEn @label.LabelAr @perm">
                                <td>@(isAr ? label.LabelAr : label.LabelEn)</td>
                                @foreach (var r in Model.Roles)
                                {
                                    var on = r.IsLocked || granted[r.RoleId].Contains(perm);
                                    <td class="text-center">
                                        <input class="form-check-input" type="checkbox" name="perm-@r.RoleId" value="@perm"
                                               checked="@on" disabled="@r.IsLocked"
                                               aria-label="@r.RoleName — @(isAr ? label.LabelAr : label.LabelEn)" />
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="form-text px-3 pb-3 mb-0">@L["Owner and Admin always have every permission."]</p>
    </div>

    <partial name="_FormActions" model="@Url.Action("Index")" />
</form>

<div class="sp-card p-4 mt-4">
    <h2 class="sp-form__title">@L["New role from a template"]</h2>
    <p class="form-text">@L["Copy a ready-made role, then adjust its permissions in the table above."]</p>
    <form asp-action="CreateRole" method="post" class="sp-filter-row" data-no-leave-warning>
        @Html.AntiForgeryToken()
        <div class="sp-filter-row__field">
            <label class="form-label" for="template">@L["Template"]</label>
            <select class="form-select" id="template" name="template">
                @foreach (var t in AppPermissions.RoleTemplates)
                {
                    <option value="@t.Key">@(isAr ? t.NameAr : t.NameEn) (@t.Permissions.Length)</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="role-name">@L["Role name"]</label>
            <input class="form-control" id="role-name" name="name" maxlength="50" required />
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Create role"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var search = document.getElementById('matrix-search');
            if (!search) return;
            search.addEventListener('input', function () {
                var q = search.value.trim().toLowerCase();
                document.querySelectorAll('[data-matrix-row]').forEach(function (row) {
                    row.hidden = q !== '' && row.dataset.search.toLowerCase().indexOf(q) < 0;
                });
            });
        })();
    </script>
}
