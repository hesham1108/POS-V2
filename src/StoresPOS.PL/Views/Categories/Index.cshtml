@model IReadOnlyList<CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Categories</h1>
        <p class="text-muted mb-0">Hierarchical catalog structure</p>
    </div>
    <a class="btn sp-btn-primary" asp-action="Create">Add category</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sort</th>
                    <th>English</th>
                    <th>Arabic</th>
                    <th>Parent</th>
                    <th>Children</th>
                    <th>Products</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-5">No categories yet. Create the first one.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="@(!item.IsActive ? "table-secondary" : null)">
                        <td><span class="font-monospace">@item.SortOrder</span></td>
                        <td>@item.NameEn</td>
                        <td dir="rtl">@item.NameAr</td>
                        <td>@(item.ParentName ?? "—")</td>
                        <td>@item.ChildCount</td>
                        <td>@item.ProductCount</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-badge"><span class="sp-badge-dot"></span> Active</span>
                            }
                            else
                            {
                                <span class="text-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this category?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="sp-card p-4 mt-4">
        <h2 class="h5 mb-3">Reorder</h2>
        <p class="text-muted small">Set sort order numbers then save. Lower numbers appear first within the same parent.</p>
        <form asp-action="Reorder" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                @for (var i = 0; i < Model.Count; i++)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text text-truncate" style="max-width: 60%;">@Model[i].NameEn</span>
                            <input type="hidden" name="items[@i].Id" value="@Model[i].Id" />
                            <input class="form-control" type="number" name="items[@i].SortOrder" value="@Model[i].SortOrder" />
                        </div>
                    </div>
                }
            </div>
            <button type="submit" class="btn sp-btn-primary mt-3">Save order</button>
        </form>
    </div>
}
