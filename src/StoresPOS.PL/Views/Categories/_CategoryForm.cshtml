@model CategoryFormViewModel

<div class="sp-card p-4" style="max-width: 720px;">
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" dir="rtl" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ParentCategoryId" class="form-label"></label>
                <select asp-for="ParentCategoryId" class="form-select">
                    <option value="">— Root —</option>
                    @foreach (var opt in Model.ParentOptions)
                    {
                        <option value="@opt.Id">@opt.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn sp-btn-primary">Save</button>
            <a class="btn sp-btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
