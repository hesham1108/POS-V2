@model CategoryFormViewModel
@{
    ViewData["Section"] = L["Products and categories"].Value;
    ViewData["Title"] = L["Edit category"].Value;
    ViewData["Subtitle"] = L["Update names, parent, or sort order"].Value;
}

<partial name="_PageHeader" />
<partial name="_CatalogTabs" />

<partial name="_CategoryForm" model="Model" />

@if (Model.Id.HasValue)
{
    <div class="sp-card p-4 mt-4">
        <h2 class="h6">@L["Move under another parent"]</h2>
        <form asp-action="Move" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label" for="parentCategoryId">@L["New parent"]</label>
                <select class="form-select" id="parentCategoryId" name="parentCategoryId">
                    <option value="">@L["— Root —"]</option>
                    @foreach (var opt in Model.ParentOptions)
                    {
                        if (Model.ParentCategoryId == opt.Id)
                        {
                            <option value="@opt.Id" selected>@opt.DisplayName</option>
                        }
                        else
                        {
                            <option value="@opt.Id">@opt.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn sp-btn-secondary">@L["Move"]</button>
            </div>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
