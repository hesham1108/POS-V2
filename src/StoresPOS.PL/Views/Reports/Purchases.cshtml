@model PurchasesReportViewModel
@{
    ViewData["Section"] = L["Reports"].Value;
    ViewData["Title"] = L["Purchases report"].Value;
    ViewData["Subtitle"] = L["Confirmed purchase invoices by invoice date"].Value;
    var r = Model.Report;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

@section PageActions {
    <partial name="_PrintButton" />
}

<partial name="_PageHeader" />
<partial name="_ReportTabs" />
<partial name="_ReportMeta" model="Model" />

<div class="sp-card p-3 mb-4 report-filters">
    <form method="get" class="sp-filter-row">
        <partial name="_DateRange" model="Model" />
        <div class="sp-filter-row__field">
            <label class="form-label" for="supplierId">@L["Supplier"]</label>
            <select class="form-select" id="supplierId" name="supplierId">
                <option value="">@L["All"]</option>
                @foreach (var s in Model.Suppliers)
                {
                    <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Purchases">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (Model.Chart is not null)
{
    <partial name="_ReportChart" model="Model.Chart" />
}

@if (r.InvoiceCount == 0)
{
    var empty = (L["No purchases in this period"].Value, L["Only confirmed purchase invoices are counted."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-kpis mb-4">
        <div class="sp-kpi sp-kpi--primary">
            <span class="sp-kpi__label">@L["Total purchases"]</span>
            <strong class="sp-kpi__value num">@r.Total.ToString("N2")</strong>
            <span class="sp-kpi__hint">@string.Format(L["{0} invoices"].Value, r.InvoiceCount)</span>
        </div>
        <div class="sp-kpi">
            <span class="sp-kpi__label">@L["Suppliers"]</span>
            <strong class="sp-kpi__value num">@r.BySupplier.Count</strong>
        </div>
        <div class="sp-kpi">
            <span class="sp-kpi__label">@L["Products"]</span>
            <strong class="sp-kpi__value num">@r.ByProduct.Count</strong>
        </div>
    </div>

    <div class="report-grid mb-4">
        <section class="sp-card p-4">
            <h2 class="shift-section-title">@L["By supplier"]</h2>
            <table class="table sp-table">
                <thead><tr><th>@L["Supplier"]</th><th class="text-end">@L["Invoices"]</th><th class="text-end">@L["Amount"]</th></tr></thead>
                <tbody>
                    @foreach (var s in r.BySupplier)
                    {
                        <tr>
                            <td><a asp-controller="Suppliers" asp-action="Details" asp-route-id="@s.Id">@(isAr && !string.IsNullOrEmpty(s.NameAr) ? s.NameAr : s.Name)</a></td>
                            <td class="text-end num">@s.Count</td>
                            <td class="text-end num">@s.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="sp-card p-4">
            <h2 class="shift-section-title">@L["By product"]</h2>
            <div class="table-responsive">
                <table class="table sp-table">
                    <thead><tr><th>@L["Product"]</th><th class="text-end">@L["Qty"]</th><th class="text-end">@L["Avg cost"]</th><th class="text-end">@L["Amount"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in r.ByProduct)
                        {
                            <tr>
                                <td>@(isAr && !string.IsNullOrEmpty(p.NameAr) ? p.NameAr : p.Name)</td>
                                <td class="text-end num">@p.Quantity.ToString("0.###")</td>
                                <td class="text-end num">@(p.Quantity == 0 ? "—" : (p.Amount / p.Quantity).ToString("N2"))</td>
                                <td class="text-end num">@p.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="sp-card">
        <div class="table-responsive">
            <table class="table sp-table">
                <thead>
                    <tr>
                        <th>@L["Invoice"]</th>
                        <th>@L["Date"]</th>
                        <th>@L["Supplier"]</th>
                        <th class="text-end">@L["Items"]</th>
                        <th class="text-end">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in r.Invoices)
                    {
                        <tr>
                            <td><a asp-controller="Purchases" asp-action="Details" asp-route-id="@i.Id">@i.InvoiceNumber</a></td>
                            <td class="num">@i.InvoiceDate.ToString("yyyy/MM/dd")</td>
                            <td>@i.SupplierName</td>
                            <td class="text-end num">@i.LineCount</td>
                            <td class="text-end num">@i.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4">@string.Format(L["{0} invoices"].Value, r.InvoiceCount)</th>
                        <th class="text-end num num-total">@r.Total.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ReportScripts" />
}
