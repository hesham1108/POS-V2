@model ShiftsReportViewModel
@{
    ViewData["Section"] = L["Reports"].Value;
    ViewData["Title"] = L["Shifts report"].Value;
    ViewData["Subtitle"] = L["Cash differences, unreconciled shifts and sales per cashier"].Value;
    var r = Model.Report;
}

@section PageActions {
    <partial name="_PrintButton" />
}

<partial name="_PageHeader" />
<partial name="_ReportTabs" />
<partial name="_ReportMeta" model="Model" />

<div class="sp-card p-3 mb-4 report-filters">
    <form method="get" class="sp-filter-row">
        <partial name="_DateRange" model="Model" />
        <div class="sp-filter-row__field">
            <label class="form-label" for="userId">@L["Cashier"]</label>
            <select class="form-select" id="userId" name="userId">
                <option value="">@L["All"]</option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.Id" selected="@(Model.UserId == u.Id)">@u.Name</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="result">@L["Result"]</label>
            <select class="form-select" id="result" name="result">
                <partial name="_ShiftResultOptions" model="Model.Result" />
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Shifts">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (r.ShiftCount == 0)
{
    var empty = (L["No shifts in this period"].Value, L["Shifts are listed by the day they were opened."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-kpis mb-4">
        <div class="sp-kpi sp-kpi--primary">
            <span class="sp-kpi__label">@L["Shifts"]</span>
            <strong class="sp-kpi__value num">@r.ShiftCount</strong>
            <span class="sp-kpi__hint">@string.Format(L["{0} matched"].Value, r.MatchedCount)</span>
        </div>
        <div class="sp-kpi @(r.ShortageTotal < 0 ? "sp-kpi--bad" : null)">
            <span class="sp-kpi__label">@L["Shortages"]</span>
            <strong class="sp-kpi__value num" dir="ltr">@r.ShortageTotal.ToString("N2")</strong>
        </div>
        <div class="sp-kpi @(r.SurplusTotal > 0 ? "sp-kpi--warn" : null)">
            <span class="sp-kpi__label">@L["Surpluses"]</span>
            <strong class="sp-kpi__value num" dir="ltr">+@r.SurplusTotal.ToString("N2")</strong>
        </div>
        <div class="sp-kpi @(r.NotReconciledCount > 0 ? "sp-kpi--warn" : null)">
            <span class="sp-kpi__label">@L["Not reconciled"]</span>
            <strong class="sp-kpi__value num">@r.NotReconciledCount</strong>
            <span class="sp-kpi__hint">@L["Closed without counting the cash"]</span>
        </div>
    </div>

    <section class="sp-card mb-4">
        <partial name="_ShiftHistoryTable" model="r.Shifts" />
    </section>

    <section class="sp-card p-4" style="max-width: 720px;">
        <h2 class="shift-section-title">@L["Sales by cashier"]</h2>
        <table class="table align-middle mb-0">
            <thead><tr><th>@L["Cashier"]</th><th class="text-end">@L["Invoices"]</th><th class="text-end">@L["Amount"]</th></tr></thead>
            <tbody>
                @foreach (var c in r.ByCashier)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td class="text-end num">@c.Count</td>
                        <td class="text-end num">@c.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2">@L["Total"]</th>
                    <th class="text-end num num-total">@r.SalesTotal.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </section>
}
