@model ChequesReportViewModel
@{
    ViewData["Section"] = L["Reports"].Value;
    ViewData["Title"] = L["Cheques report"].Value;
    ViewData["Subtitle"] = L["By status and due date"].Value;
    var r = Model.Report;
}

@section PageActions {
    <partial name="_PrintButton" />
}

<partial name="_PageHeader" />
<partial name="_ReportTabs" />
<partial name="_ReportMeta" model="Model" />

<div class="sp-card p-3 mb-4 report-filters">
    <form method="get" class="sp-filter-row">
        <partial name="_DateRange" model="Model" />
        <div class="sp-filter-row__field">
            <label class="form-label">@L["Direction"]</label>
            <select class="form-select" name="direction" asp-items="Html.GetEnumSelectList<ChequeDirection>()">
                <option value="">@L["All"]</option>
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label">@L["Status"]</label>
            <select class="form-select" name="status" asp-items="Html.GetEnumSelectList<ChequeStatus>()">
                <option value="">@L["All"]</option>
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Cheques">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (r.Rows.Count == 0)
{
    var empty = (L["No cheques"].Value, L["Cheques due in this range appear here."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="sp-kpis mb-4">
        <div class="sp-kpi sp-kpi--primary">
            <span class="sp-kpi__label">@L["Total"]</span>
            <strong class="sp-kpi__value num">@r.TotalAmount.ToString("N2")</strong>
            <span class="sp-kpi__hint">@string.Format(L["{0} cheques"].Value, r.Rows.Count)</span>
        </div>
    </div>

    <div class="report-grid mb-4">
        <section class="sp-card p-4">
            <h2 class="shift-section-title">@L["By status"]</h2>
            <table class="table align-middle mb-0">
                <thead><tr><th>@L["Status"]</th><th class="text-end">@L["Count"]</th><th class="text-end">@L["Amount"]</th></tr></thead>
                <tbody>
                @foreach (var s in r.ByStatus)
                {
                    <tr><td>@s.Name</td><td class="text-end num">@s.Count</td><td class="text-end num">@s.Amount.ToString("N2")</td></tr>
                }
                </tbody>
            </table>
        </section>
    </div>

    <div class="sp-card p-0 overflow-hidden">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Number"]</th>
                    <th>@L["Direction"]</th>
                    <th>@L["Party"]</th>
                    <th>@L["Due date"]</th>
                    <th class="text-end">@L["Amount"]</th>
                    <th>@L["Status"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in r.Rows)
            {
                <tr>
                    <td><a asp-controller="Cheques" asp-action="Details" asp-route-id="@row.Id">@row.Number</a></td>
                    <td>@(row.Direction == ChequeDirection.In ? L["Receivable (لينا)"].Value : L["Payable (علينا)"].Value)</td>
                    <td>@(row.CustomerName ?? row.SupplierName)</td>
                    <td class="num">@row.DueDate.ToString("yyyy/MM/dd")</td>
                    <td class="text-end num">@row.Amount.ToString("N2")</td>
                    <td>@row.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
