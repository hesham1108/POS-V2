@model WarehouseIndexViewModel
@{
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Transfers">@L["Transfers"]</a>
    @if (Model.CanTransfer)
    {
        <a class="btn sp-btn-secondary" asp-action="Transfer">@L["New transfer"]</a>
    }
    @if (Model.CanManage)
    {
        <a class="btn sp-btn-primary" asp-action="Create">@L["Add warehouse"]</a>
    }
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <label class="sp-filter-row__check form-check" for="includeInactive">
            <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                   @(Model.IncludeInactive ? "checked" : null) />
            <span class="form-check-label">@L["Include inactive"]</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Warehouse"]</th>
                    <th>@L["Location"]</th>
                    <th class="col-num">@L["Products"]</th>
                    <th class="col-num">@L["Qty"]</th>
                    <th>@L["Status"]</th>
                    <th class="col-num">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Warehouses.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <partial name="_EmptyState" model='(@L["No warehouses yet"].Value, @L["Add a warehouse to hold stock."].Value)' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Warehouses)
                {
                    var name = isAr ? item.NameAr : item.NameEn;
                    <tr>
                        <td>
                            <div class="fw-semibold">@name</div>
                            <div class="small text-muted" dir="@(isAr ? "ltr" : "rtl")">@(isAr ? item.NameEn : item.NameAr)</div>
                            @if (item.IsDefault)
                            {
                                <span class="sp-badge mt-1">@L["Default"]</span>
                            }
                        </td>
                        <td>@(item.Location ?? "—")</td>
                        <td class="col-num num">@item.ProductCount</td>
                        <td class="col-num num fw-semibold">@item.TotalQuantity.ToString("0.###")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-status sp-status-ok">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">@L["Inactive"]</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Stock" asp-route-id="@item.Id">@L["Stock"]</a>
                            @if (Model.CanManage)
                            {
                                <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('@L["Deactivate this warehouse?"]');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm sp-btn-secondary">@L["Deactivate"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm sp-btn-secondary">@L["Activate"]</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
