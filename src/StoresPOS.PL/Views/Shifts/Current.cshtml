@model ShiftCurrentViewModel
@{
    ViewData["Section"] = L["Shifts"].Value;
    ViewData["Title"] = L["Current shift"].Value;
    ViewData["Subtitle"] = L["Live drawer totals · cash only counts toward the drawer"].Value;
}

@section PageActions {
    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.ReportsView))
    {
        <a class="btn sp-btn-secondary" asp-action="Index">@L["Shift history"]</a>
    }
    @if (!Model.IsParticipant)
    {
        <form asp-action="Resume" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn sp-btn-secondary">@L["Join shift"]</button>
        </form>
    }
    @if (Model.CanClose || User.HasClaim(AppPermissions.ClaimType, AppPermissions.ReportsView))
    {
        var xReportUrl = Url.Action("Shift", "Receipts", new { id = Model.Summary.Id });
        <partial name="_PaperFormatPicker" model="StoresPOS.BLL.Models.PrintDocumentType.Shift" />
        <button type="button" class="btn sp-btn-secondary" data-print-url="@xReportUrl" data-format-base="@xReportUrl">@L["Print X report"]</button>
    }
    @if (Model.CanCashOut)
    {
        <button type="button" class="btn sp-btn-secondary" data-cashout>@L["New cash-out"]</button>
    }
    @if (Model.CanClose)
    {
        <a class="btn sp-btn-primary" asp-action="Close">@L["Close shift"]</a>
    }
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="shift-layout">
    <partial name="_ShiftSummary" model="Model.Summary" />

    <div class="d-flex flex-column gap-4">
    <section class="sp-card p-4">
        <h2 class="shift-section-title">@L["Sales by cashier"]</h2>
        <div class="table-responsive">
            <table class="table sp-table">
                <thead>
                    <tr>
                        <th>@L["Cashier"]</th>
                        <th class="text-end">@L["Invoices"]</th>
                        <th class="text-end">@L["Cash"]</th>
                        <th class="text-end">@L["Non-cash"]</th>
                        <th class="text-end">@L["Cash-outs"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Summary.Participants)
                    {
                        <tr>
                            <td>@p.DisplayName</td>
                            <td class="text-end num">@p.InvoiceCount</td>
                            <td class="text-end num">@p.CashSales.ToString("N2")</td>
                            <td class="text-end num">@p.NonCashSales.ToString("N2")</td>
                            <td class="text-end num">@p.CashOuts.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.IsParticipant)
        {
            <a class="btn sp-btn-primary mt-3" asp-controller="Pos" asp-action="Index">@L["Back to selling"]</a>
        }
    </section>

    <section class="sp-card p-4">
        <h2 class="shift-section-title">@L["Cash-outs"]</h2>
        @if (Model.CashOuts.Count == 0)
        {
            var empty = (L["No cash-outs yet"].Value, L["Cash taken from the drawer appears here and lowers expected cash."].Value);
            <partial name="_EmptyState" model="empty" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table sp-table">
                    <thead>
                        <tr>
                            <th>@L["Time"]</th>
                            <th>@L["User"]</th>
                            <th>@L["Reason"]</th>
                            <th class="text-end">@L["Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.CashOuts)
                        {
                            <tr>
                                <td class="num">@c.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</td>
                                <td>@c.UserDisplayName</td>
                                <td>@c.Reason</td>
                                <td class="text-end num">@c.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
</div>

@if (Model.CanCashOut)
{
    <partial name="_CashOutModal" />
}

@section Scripts {
    @if (Model.CanCashOut)
    {
        <script src="~/js/cashout.js" asp-append-version="true"></script>
    }
}
