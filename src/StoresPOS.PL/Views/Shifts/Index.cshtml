@model ShiftHistoryViewModel
@{
    ViewData["Section"] = L["Shifts"].Value;
    ViewData["Title"] = L["Shift history"].Value;
    ViewData["Subtitle"] = L["Every shift with its drawer result · open one to see sales, cash-outs and returns"].Value;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Current">@L["Current shift"]</a>
    <a class="btn sp-btn-secondary" asp-controller="Reports" asp-action="Shifts">@L["Shifts report"]</a>
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="from">@L["From"]</label>
            <input class="form-control" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="to">@L["To"]</label>
            <input class="form-control" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="result">@L["Result"]</label>
            <select class="form-select" id="result" name="result">
                <partial name="_ShiftResultOptions" model="Model.Result" />
            </select>
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" for="userId">@L["Cashier"]</label>
            <select class="form-select" id="userId" name="userId">
                <option value="">@L["All"]</option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.Id" selected="@(Model.UserId == u.Id)">@u.Name</option>
                }
            </select>
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-primary">@L["Filter"]</button>
            <a class="btn sp-btn-secondary" asp-action="Index">@L["Reset"]</a>
        </div>
    </form>
</div>

@if (Model.Shifts.Count == 0)
{
    var empty = (L["No shifts found"].Value, L["Shifts appear here once they are opened from the POS gate."].Value);
    <partial name="_EmptyState" model="empty" />
}
else
{
    <section class="sp-card">
        <partial name="_ShiftHistoryTable" model="Model.Shifts" />
    </section>
}
