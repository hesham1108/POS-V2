@model TreasuryMoveViewModel
@{
    var isDeposit = string.Equals(Model.Mode, "deposit", StringComparison.OrdinalIgnoreCase);
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Statement" asp-route-id="@Model.TreasuryId">@L["Cancel"]</a>
}

<partial name="_PageHeader" />

<div class="sp-card p-4" style="max-width:520px">
    <p class="mb-3">
        <strong>@Model.TreasuryName</strong>
        · @L["Balance"] <span class="num fw-semibold">@Model.Balance.ToString("N2")</span>
    </p>
    <form asp-action="Move" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TreasuryId" />
        <input type="hidden" asp-for="TreasuryName" />
        <input type="hidden" asp-for="Balance" />
        <input type="hidden" asp-for="Mode" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control form-control-lg num" inputmode="decimal" step="0.01" min="0.01" autofocus />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
        <button type="submit" class="btn sp-btn-primary">@(isDeposit ? L["Deposit"].Value : L["Withdraw"].Value)</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
