@model TreasuryStatementViewModel
@{
    var s = Model.Statement;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var name = isAr ? s.Treasury.NameAr : s.Treasury.NameEn;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">@L["Back"]</a>
    <a class="btn sp-btn-secondary"
       asp-action="Statement"
       asp-route-id="@s.Treasury.Id"
       asp-route-from="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
       asp-route-to="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
       asp-route-print="true">@L["Print"]</a>
}

<partial name="_PageHeader" />
<partial name="_Flash" />

<div class="sp-card p-3 mb-4 no-print">
    <form method="get" class="sp-filter-row" asp-action="Statement" asp-route-id="@s.Treasury.Id">
        <div class="sp-filter-row__field">
            <label class="form-label" asp-for="FromDate"></label>
            <input class="form-control" type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__field">
            <label class="form-label" asp-for="ToDate"></label>
            <input class="form-control" type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">@L["Filter"]</button>
        </div>
    </form>
</div>

<div class="sp-kpis mb-4">
    <div class="sp-kpi">
        <span class="sp-kpi__label">@L["Opening"]</span>
        <strong class="sp-kpi__value num">@s.OpeningBalanceAtFrom.ToString("N2")</strong>
    </div>
    <div class="sp-kpi">
        <span class="sp-kpi__label">@L["In"]</span>
        <strong class="sp-kpi__value num">@s.TotalIn.ToString("N2")</strong>
    </div>
    <div class="sp-kpi">
        <span class="sp-kpi__label">@L["Out"]</span>
        <strong class="sp-kpi__value num">@s.TotalOut.ToString("N2")</strong>
    </div>
    <div class="sp-kpi sp-kpi--primary">
        <span class="sp-kpi__label">@L["Closing"]</span>
        <strong class="sp-kpi__value num">@s.ClosingBalance.ToString("N2")</strong>
        <span class="sp-kpi__hint">@name</span>
    </div>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Date"]</th>
                    <th>@L["Direction"]</th>
                    <th>@L["Source"]</th>
                    <th class="col-num">@L["Amount"]</th>
                    <th class="col-num">@L["Balance"]</th>
                    <th>@L["User"]</th>
                    <th>@L["Note"]</th>
                </tr>
            </thead>
            <tbody>
            @if (s.Rows.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='(@L["No movements in this range"].Value, @L["Deposit, withdraw, transfer, shift close, sales and purchases appear here."].Value)' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var row in s.Rows)
                {
                    <tr>
                        <td class="num">@row.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (row.Direction == TreasuryTransactionDirection.In)
                            {
                                <span class="sp-status sp-status-ok">@L["In"]</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-warn">@L["Out"]</span>
                            }
                        </td>
                        <td>@row.SourceType</td>
                        <td class="col-num font-monospace">@row.Amount.ToString("N2")</td>
                        <td class="col-num font-monospace">@(row.RunningBalance?.ToString("N2") ?? "—")</td>
                        <td>@row.UserDisplayName</td>
                        <td>@(row.Note ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Print)
{
    <script>window.addEventListener('load', function () { window.print(); });</script>
}
