@model SupplierDto
@{
    ViewData["Section"] = "Suppliers";
    ViewData["Title"] = Model.NameEn;
    ViewData["Subtitle"] = Model.NameAr;
    var cheques = (IReadOnlyList<ChequeListItemDto>)(ViewBag.Cheques ?? Array.Empty<ChequeListItemDto>());
    decimal outstanding = ViewBag.OutstandingCheques ?? 0m;
}

@section PageActions {
    <a class="btn sp-btn-secondary" asp-action="Index">Back</a>
    <a class="btn sp-btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn sp-btn-secondary" asp-controller="Purchases" asp-action="Index" asp-route-supplierId="@Model.Id">Purchases</a>
    @if (User.HasClaim(AppPermissions.ClaimType, AppPermissions.ChequesManage))
    {
        <a class="btn sp-btn-secondary" asp-controller="Cheques" asp-action="Create"
           asp-route-direction="@((int)ChequeDirection.Out)" asp-route-supplierId="@Model.Id">@L["Add cheque"]</a>
    }
}

<partial name="_PageHeader" />

<div class="sp-card p-4 mb-4" style="max-width: 720px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@(Model.Email ?? "—")</dd>
        <dt class="col-sm-4">Address</dt>
        <dd class="col-sm-8">@(Model.Address ?? "—")</dd>
        <dt class="col-sm-4">Notes</dt>
        <dd class="col-sm-8">@(Model.Notes ?? "—")</dd>
        <dt class="col-sm-4">Confirmed purchases</dt>
        <dd class="col-sm-8 font-monospace">@Model.ConfirmedPurchaseCount</dd>
        <dt class="col-sm-4">Total amount</dt>
        <dd class="col-sm-8 font-monospace">@Model.TotalPurchasesAmount.ToString("N2") EGP</dd>
        <dt class="col-sm-4">@L["Outstanding cheques"]</dt>
        <dd class="col-sm-8 font-monospace">@outstanding.ToString("N2") EGP</dd>
        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</div>

<section class="sp-card p-4">
    <h2 class="shift-section-title">@L["Cheques"]</h2>
    @if (cheques.Count == 0)
    {
        <p class="text-muted mb-0">@L["No cheques"]</p>
    }
    else
    {
        <table class="table align-middle mb-0">
            <thead><tr><th>@L["Number"]</th><th>@L["Due date"]</th><th class="text-end">@L["Amount"]</th><th>@L["Status"]</th></tr></thead>
            <tbody>
            @foreach (var ch in cheques)
            {
                <tr>
                    <td><a asp-controller="Cheques" asp-action="Details" asp-route-id="@ch.Id">@ch.Number</a></td>
                    <td class="num">@ch.DueDate.ToString("yyyy/MM/dd")</td>
                    <td class="text-end num">@ch.Amount.ToString("N2")</td>
                    <td>@ch.Status</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
