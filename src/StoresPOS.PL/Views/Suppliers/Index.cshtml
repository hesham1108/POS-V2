@model SupplierIndexViewModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Suppliers</h1>
        <p class="text-muted mb-0">Contacts and purchase totals</p>
    </div>
    <a class="btn sp-btn-primary" asp-action="Create">Add supplier</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name, phone, email" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                       @(Model.IncludeInactive ? "checked" : null) />
                <label class="form-check-label" for="includeInactive">Include inactive</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn sp-btn-secondary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Supplier</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th class="text-end">Purchases</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Suppliers.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">No suppliers yet.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Suppliers)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.NameEn</div>
                            <div class="small text-muted" dir="rtl">@item.NameAr</div>
                        </td>
                        <td>@(item.Phone ?? "—")</td>
                        <td>@(item.Email ?? "—")</td>
                        <td class="text-end font-monospace">@item.ConfirmedPurchaseCount</td>
                        <td class="text-end font-monospace">@item.TotalPurchasesAmount.ToString("N2")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-badge"><span class="sp-badge-dot"></span> Active</span>
                            }
                            else
                            {
                                <span class="text-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this supplier?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
