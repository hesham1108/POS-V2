@model SupplierIndexViewModel
@{
    ViewData["Section"] = "Suppliers";
    ViewData["Title"] = "Suppliers";
    ViewData["Subtitle"] = "Contacts and purchase totals";
}

@section PageActions {
    <a class="btn sp-btn-primary" asp-action="Create">Add supplier</a>
}

<partial name="_PageHeader" />

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="sp-card p-3 mb-4">
    <form method="get" class="sp-filter-row">
        <div class="sp-filter-row__field">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name, phone, email" />
        </div>
        <label class="sp-filter-row__check form-check" for="includeInactive">
            <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive"
                   @(Model.IncludeInactive ? "checked" : null) />
            <span class="form-check-label">Include inactive</span>
        </label>
        <div class="sp-filter-row__actions">
            <button type="submit" class="btn sp-btn-secondary">Filter</button>
        </div>
    </form>
</div>

<div class="sp-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th class="col-num">Purchases</th>
                    <th class="col-num">Total</th>
                    <th>Status</th>
                    <th class="col-num">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Suppliers.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <partial name="_EmptyState" model='("No suppliers yet", "Add a supplier before recording purchase invoices.")' />
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Suppliers)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.NameEn</div>
                            <div class="small text-muted" dir="rtl">@item.NameAr</div>
                        </td>
                        <td>@(item.Phone ?? "—")</td>
                        <td>@(item.Email ?? "—")</td>
                        <td class="col-num font-monospace">@item.ConfirmedPurchaseCount</td>
                        <td class="col-num font-monospace">@item.TotalPurchasesAmount.ToString("N2")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="sp-status sp-status-ok">Active</span>
                            }
                            else
                            {
                                <span class="sp-status sp-status-neutral">Inactive</span>
                            }
                        </td>
                        <td class="col-num text-nowrap">
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm sp-btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this supplier?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
